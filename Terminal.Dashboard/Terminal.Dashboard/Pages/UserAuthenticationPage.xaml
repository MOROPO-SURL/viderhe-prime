<?xml version="1.0" encoding="utf-8" ?>
<sscxftoolkitmvvmpages:BindingContextedContentPage 
    xmlns="http://xamarin.com/schemas/2014/forms"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:pagemodels="clr-namespace:SmartSolucionesCuba.Viderhe.Terminal.Dashboard.Models.Page"
    xmlns:supportpresentationdashboardviews="clr-namespace:SmartSolucionesCuba.Viderhe.Support.Presentation.Dashboard.Views;assembly=SmartSolucionesCuba.Viderhe.Support.Presentation.Dashboard"
    xmlns:sscxftoolkitmvvmpages="clr-namespace:SmartSolucionesCuba.XFToolKit.Mvvm.Pages;assembly=SmartSolucionesCuba.XFToolKit.Mvvm"
    xmlns:sscxftoolkitpresentationconverters="clr-namespace:SmartSolucionesCuba.XFToolKit.Presentation.Converters;assembly=SmartSolucionesCuba.XFToolKit.Presentation"
    xmlns:ffimageloadingsvg="clr-namespace:FFImageLoading.Svg.Forms;assembly=FFImageLoading.Svg.Forms"
    x:Class="SmartSolucionesCuba.Viderhe.Terminal.Dashboard.Pages.UserAuthenticationPage"
    x:TypeArguments="pagemodels:UserAuthenticationPageModel">
    <ContentPage.Resources>
        <ResourceDictionary>
            <sscxftoolkitpresentationconverters:BoolToBoolNegationConverter x:Key="BoolToBoolNegationConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>
    <ContentPage.Content>
        <Grid>
            <ScrollView
                HorizontalOptions="Center"
                Orientation="Vertical">
                <Grid>
                    <Grid 
                        HorizontalOptions="Center" VerticalOptions="Center"
                        WidthRequest="280">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="75" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <ffimageloadingsvg:SvgCachedImage
                            Grid.ColumnSpan="2" Grid.Row="0"
                            HorizontalOptions="Center"
                            WidthRequest="320" HeightRequest="320"
                            Source="resource://SmartSolucionesCuba.Viderhe.Terminal.Dashboard.Assets.Images.viderhe-identity-main.svg"
                            Aspect="AspectFill" />
                        <Picker
                            Grid.Column="0" Grid.Row="1"
                            ItemsSource="{Binding Path=AvailableProtocols}"
                            SelectedIndex="{Binding Path=TargetCloudProtocolIndex, FallbackValue=0, TargetNullValue=0}" />
                        <Entry
                            Grid.Column="1" Grid.Row="1"
                            Text="{Binding Path=TargetCloudHostName}"
                            Placeholder="servidor cloud" />
                        <Entry
                            Grid.ColumnSpan="2" Grid.Row="2"
                            Text="{Binding Path=UserName}"
                            Placeholder="usuario" />
                        <Entry
                            Grid.ColumnSpan="2" Grid.Row="3"
                            Text="{Binding Path=Password}"
                            Placeholder="contraseña"
                            IsPassword="true" />
                        <Button
                            Grid.ColumnSpan="2" Grid.Row="4"
                            IsEnabled="{Binding Path=IsBusy, Converter={StaticResource BoolToBoolNegationConverter}}"
                            HorizontalOptions="FillAndExpand"
                            Margin="24"
                            BackgroundColor="Accent"
                            Text="Iniciar"
                            TextColor="White"
                            Clicked="SignButton_Clicked" />
                    </Grid>
                </Grid>
            </ScrollView>
            <supportpresentationdashboardviews:BusyView />
        </Grid>       
    </ContentPage.Content>
</sscxftoolkitmvvmpages:BindingContextedContentPage>