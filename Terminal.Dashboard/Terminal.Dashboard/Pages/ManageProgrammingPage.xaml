<?xml version="1.0" encoding="utf-8" ?>
<sscxftoolkitmvvmpages:BindingContextedContentPage 
    xmlns="http://xamarin.com/schemas/2014/forms"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:d="http://xamarin.com/schemas/2014/forms/design"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:pagemodels="clr-namespace:SmartSolucionesCuba.Viderhe.Terminal.Dashboard.Models.Page"
    xmlns:supportpresentationdashboardviews="clr-namespace:SmartSolucionesCuba.Viderhe.Support.Presentation.Dashboard.Views;assembly=SmartSolucionesCuba.Viderhe.Support.Presentation.Dashboard"
    xmlns:converters="clr-namespace:SmartSolucionesCuba.Viderhe.Terminal.Dashboard.Converters"
    xmlns:sscxftoolkitmvvmpages="clr-namespace:SmartSolucionesCuba.XFToolKit.Mvvm.Pages;assembly=SmartSolucionesCuba.XFToolKit.Mvvm"
    xmlns:sscxftoolkitpresentationconverters="clr-namespace:SmartSolucionesCuba.XFToolKit.Presentation.Converters;assembly=SmartSolucionesCuba.XFToolKit.Presentation"
    mc:Ignorable="d"
    x:Class="SmartSolucionesCuba.Viderhe.Terminal.Dashboard.Pages.ManageProgrammingPage"
    x:TypeArguments="pagemodels:ManageProgrammingPageModel"
    Title="Gestionar Programación">
    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:PlacardViewModelToPlacardThumbnailWrapViewConverter x:Key="PlacardViewModelToPlacardThumbnailWrapViewConverter" />
            <converters:TemplateViewModelToTemplateThumbnailWrapViewConverter x:Key="TemplateViewModelToTemplateThumbnailWrapViewConverter" />
            <converters:PlacardToIsAnyPlayerOrientationSupportedConverter x:Key="PlacardToIsAnyPlayerOrientationSupportedConverter" />

            <sscxftoolkitpresentationconverters:IfNullOrEmptyToStringConverter x:Key="IfNullOrEmptyToStringConverter" StringReplacement="Descripción no especificada" />
            <sscxftoolkitpresentationconverters:NullToBooleanConverter x:Key="NullToBooleanConverter" />
            <sscxftoolkitpresentationconverters:BoolToBoolNegationConverter x:Key="BoolToBoolNegationConverter" />
            <sscxftoolkitpresentationconverters:EnumerableEmptyToBooleanConverter x:Key="EnumerableEmptyToBooleanConverter" />
            <sscxftoolkitpresentationconverters:BindingLayoutWidthToResponsiveChildWidthConverter x:Key="BindingLayoutWidthToResponsiveChildWidthConverter" ChildMinWidth="240" ChildAbsoluteHorizontalMargin="10" />
        </ResourceDictionary>
    </ContentPage.Resources>
    <ContentPage.ToolbarItems>
        <ToolbarItem
            Text="Actualizar"
            Clicked="ReloadToolbarItem_Clicked">
            <ToolbarItem.IconImageSource>
                <FontImageSource FontFamily="{StaticResource IconFontFamily}" Glyph="&#xf6ea;">
                    <FontImageSource.Color>
                        <OnPlatform x:TypeArguments="Color">
                            <On Platform="UWP" Value="Black" />
                        </OnPlatform>
                    </FontImageSource.Color>
                </FontImageSource>
            </ToolbarItem.IconImageSource>
        </ToolbarItem>
    </ContentPage.ToolbarItems>
    <ContentPage.Content>
        <Grid ColumnSpacing="0" RowSpacing="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240" />
                <ColumnDefinition Width="300" />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition />
            </Grid.RowDefinitions>
            <StackLayout
                Grid.Column="0" Grid.Row="0"
                Padding="10"
                Orientation="Horizontal"
                BackgroundColor="LightGray"
                Spacing="4">
                <Label
                    VerticalOptions="Center" 
                    Text="&#xf411;"
                    FontFamily="{StaticResource IconFontFamily}"
                    FontSize="Large" />
                <Label 
                    VerticalOptions="Center" 
                    HorizontalOptions="FillAndExpand"
                    Text="Guiones"
                    FontSize="Medium" />
                <Button 
                    Text="&#xf415;"
                    FontFamily="{StaticResource IconFontFamily}"
                    FontSize="Medium"
                    Clicked="AddScreenplayButton_Clicked" />
            </StackLayout>
            <CollectionView
                Grid.Column="0" Grid.Row="1"
                BackgroundColor="White"
                ItemsSource="{Binding Path=Screenplays}"
                ItemSizingStrategy="MeasureAllItems"
                SelectionMode="Single"
                SelectionChanged="ScreenplayCollectionView_SelectionChanged">
                <CollectionView.EmptyView>
                    <StackLayout>
                        <Label
                            IsVisible="{Binding Path=IsBusy, Converter={StaticResource BoolToBoolNegationConverter}}"
                            Padding="10"
                            TextColor="DimGray"
                            Text="Sin elementos que mostrar" />
                    </StackLayout>
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Grid 
                            Padding="12,8,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition />
                            </Grid.RowDefinitions>
                            <Label
                                Grid.Column="0" Grid.Row="0"
                                Text="{Binding Path=Title}"
                                LineBreakMode="TailTruncation"
                                MaxLines="2" />
                            <Label 
                                Grid.Column="0" Grid.Row="1"
                                Text="{Binding Path=About, Converter={StaticResource IfNullOrEmptyToStringConverter}}"
                                TextColor="DimGray"
                                LineBreakMode="TailTruncation"
                                MaxLines="2"
                                FontSize="Caption" />
                            <Button 
                                Grid.Column="1" Grid.RowSpan="2"
                                VerticalOptions="Center"
                                WidthRequest="24" HeightRequest="36"
                                BorderWidth="0"
                                Padding="0,6"
                                Text="&#xF1D9;"
                                FontFamily="{StaticResource IconFontFamily}"
                                FontSize="Medium"
                                Clicked="ScreenplayOptionsButton_Clicked" />
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
            <StackLayout
                Grid.Column="1" Grid.Row="0"
                Padding="10"
                Orientation="Horizontal"
                BackgroundColor="DarkGray"
                Spacing="4">
                <Label
                    VerticalOptions="Center" 
                    Text="&#xf328;"
                    FontFamily="{StaticResource IconFontFamily}"
                    FontSize="Large" />
                <Label 
                    VerticalOptions="Center" 
                    HorizontalOptions="FillAndExpand"
                    Text="Secuencia"
                    FontSize="Medium" />
                <Button 
                    IsEnabled="{Binding Path=Frames, Converter={StaticResource EnumerableEmptyToBooleanConverter}}"
                    Text="&#xf40a;"
                    FontFamily="{StaticResource IconFontFamily}"
                    FontSize="Medium"
                    Clicked="ScreenplayFramesPlayButton_Clicked" />
            </StackLayout>
            <Grid                
                Grid.Column="1" Grid.Row="1"
                BackgroundColor="#EAEAEA">
                <CollectionView                     
                    Margin="0,4"
                    ItemsSource="{Binding Path=Frames}">
                    <CollectionView.EmptyView>
                        <StackLayout>
                            <Label
                                Margin="10,8"
                                BindingContext="{x:Reference Name=UnselectedScreenplayInticatorViewGroup}"
                                IsVisible="{Binding IsVisible, Converter={StaticResource BoolToBoolNegationConverter}}"
                                Text="Sin elementos que mostrar"
                                TextColor="DimGray" />
                        </StackLayout>
                    </CollectionView.EmptyView>
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <ContentView>
                                <Grid
                                    Margin="8,4,0,4"
                                    BackgroundColor="#F5F5F5"
                                    ColumnSpacing="8"
                                    HeightRequest="96">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid
                                        Grid.Column="0"             
                                        Margin="1,0"
                                        WidthRequest="96">
                                        <BoxView Color="LightGray" />
                                        <Label
                                            IsVisible="{Binding Path=Placard, Converter={StaticResource PlacardToIsAnyPlayerOrientationSupportedConverter}}"
                                            HorizontalOptions="End" VerticalOptions="Start"
                                            Margin="3"
                                            Text="&#xf884;"
                                            TextColor="Black"
                                            FontFamily="Material Design Icons" />
                                        <ContentView Content="{Binding Path=Placard.Template, Converter={StaticResource TemplateViewModelToTemplateThumbnailWrapViewConverter}}" />
                                    </Grid>
                                    <Label
                                        Grid.Column="1"
                                        Text="{Binding Path=Placard.Label}"
                                        TextColor="Black"
                                        FontSize="Caption"
                                        VerticalTextAlignment="Center"
                                        LineBreakMode="TailTruncation"
                                        MaxLines="4" />
                                    <Button 
                                        Grid.Column="2"
                                        VerticalOptions="Center"
                                        BackgroundColor="Transparent"
                                        BorderWidth="0"
                                        Padding="0,6"
                                        Text="&#xF1D9;"
                                        FontFamily="{StaticResource IconFontFamily}"
                                        FontSize="Medium"
                                        Clicked="FrameOverviewOptionsButton_Clicked" />
                                </Grid>
                            </ContentView>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </Grid>
            <StackLayout
                x:Name="UnselectedScreenplayInticatorViewGroup"
                Grid.Column="1" Grid.Row="1"
                IsVisible="{Binding Path=SelectedScreenplay, Converter={StaticResource NullToBooleanConverter}}">
                <Label
                    HorizontalOptions="CenterAndExpand"
                    VerticalOptions="CenterAndExpand"
                    HorizontalTextAlignment="Center"
                    Margin="20"
                    TextColor="DimGray"
                    Text="Seleccione el guión a gestionar secuencia de marcos" />
            </StackLayout>
            <StackLayout
                Grid.Column="2" Grid.Row="0"
                Padding="10"
                Orientation="Horizontal"
                BackgroundColor="LightSlateGray"
                Spacing="4">
                <Label
                    VerticalOptions="Center" 
                    Text="&#xf0e5;"
                    FontFamily="{StaticResource IconFontFamily}"
                    FontSize="Large" />
                <Label 
                    VerticalOptions="Center" 
                    HorizontalOptions="FillAndExpand"
                    Text="Marcos"
                    FontSize="Medium" />
                <Button 
                    Text="&#xf415;"
                    FontFamily="{StaticResource IconFontFamily}"
                    FontSize="Medium"
                    Clicked="AddPlacardButton_Clicked" />
            </StackLayout>
            <supportpresentationdashboardviews:BackgroundView Grid.Column="2" Grid.Row="1" />
            <ScrollView
                Grid.Column="2" Grid.Row="1"
                Orientation="Vertical">
                <FlexLayout
                    Margin="5"
                    Wrap="Wrap"
                    AlignItems="Start" AlignContent="Start"
                    BindableLayout.ItemsSource="{Binding Path=Placards}">
                    <BindableLayout.EmptyViewTemplate>
                        <DataTemplate>
                            <Label
                                IsVisible="{Binding Path=IsBusy, Converter={StaticResource BoolToBoolNegationConverter}}"
                                Margin="5"
                                Text="Sin elementos que mostrar"
                                TextColor="Black" />
                        </DataTemplate>
                    </BindableLayout.EmptyViewTemplate>
                    <BindableLayout.ItemTemplate>
                        <DataTemplate>
                            <Frame 
                                Padding="0" Margin="5"
                                HasShadow="False"
                                CornerRadius="0"
                                WidthRequest="{Binding Source={x:RelativeSource AncestorType={x:Type FlexLayout}}, Path=Width, Converter={StaticResource BindingLayoutWidthToResponsiveChildWidthConverter}}">
                                <Grid RowSpacing="0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid 
                                        Grid.Row="0"
                                        HeightRequest="{Binding Source={x:RelativeSource Mode=Self}, Path=Width}">
                                        <BoxView Color="White" Opacity="0.2" />
                                        <Label
                                            IsVisible="{Binding Converter={StaticResource PlacardToIsAnyPlayerOrientationSupportedConverter}}"
                                            HorizontalOptions="End" VerticalOptions="Start"
                                            Margin="8"
                                            Text="&#xf884;"
                                            TextColor="Black"
                                            FontFamily="Material Design Icons"
                                            FontSize="28" />
                                        <ContentView Content="{Binding Converter={StaticResource PlacardViewModelToPlacardThumbnailWrapViewConverter}}" />
                                    </Grid>
                                    <Grid 
                                        Grid.Row="1"
                                        BackgroundColor="White"
                                        ColumnSpacing="0" RowSpacing="0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition />
                                            <RowDefinition />
                                        </Grid.RowDefinitions>
                                        <Label
                                            Grid.Column="0" Grid.Row="0"
                                            Margin="8,8,8,4"
                                            Text="{Binding Path=Label}"
                                            LineBreakMode="TailTruncation" />
                                        <Label 
                                            Grid.Column="0" Grid.Row="1"
                                            VerticalOptions="Center"
                                            Margin="8,0,0,8"
                                            Text="{Binding Path=Template.Name}"
                                            LineBreakMode="TailTruncation"
                                            TextColor="DimGray"
                                            FontSize="Caption" />
                                        <Button 
                                            Grid.Column="1" Grid.RowSpan="2"
                                            VerticalOptions="Center"
                                            BackgroundColor="Transparent"
                                            BorderWidth="0"
                                            Padding="0,6"
                                            Text="&#xF1D9;"
                                            FontFamily="{StaticResource IconFontFamily}"
                                            FontSize="Medium"
                                            Clicked="PlacardOverviewOptionsButton_Clicked" />
                                    </Grid>
                                </Grid>
                            </Frame>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </FlexLayout>
            </ScrollView>
            <supportpresentationdashboardviews:BusyView Grid.ColumnSpan="3" Grid.RowSpan="2" />
        </Grid>
    </ContentPage.Content>
</sscxftoolkitmvvmpages:BindingContextedContentPage>