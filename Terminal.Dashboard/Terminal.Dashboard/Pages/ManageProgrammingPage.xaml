<?xml version="1.0" encoding="utf-8" ?>
<sscxftoolkitmvvmpages:BindingContextedContentPage 
    xmlns="http://xamarin.com/schemas/2014/forms"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:pagemodels="clr-namespace:SmartSolucionesCuba.Viderhe.Terminal.Dashboard.Models.Page"
    xmlns:converters="clr-namespace:SmartSolucionesCuba.Viderhe.Terminal.Dashboard.Converters"
    xmlns:supportpresentationdashboardviews="clr-namespace:SmartSolucionesCuba.Viderhe.Support.Presentation.Dashboard.Views;assembly=SmartSolucionesCuba.Viderhe.Support.Presentation.Dashboard"
    xmlns:supportpresentationdashboardconverters="clr-namespace:SmartSolucionesCuba.Viderhe.Support.Presentation.Dashboard.Converters;assembly=SmartSolucionesCuba.Viderhe.Support.Presentation.Dashboard"
    xmlns:sscxftoolkitmvvmpages="clr-namespace:SmartSolucionesCuba.XFToolKit.Mvvm.Pages;assembly=SmartSolucionesCuba.XFToolKit.Mvvm"
    xmlns:sscxftoolkitpresentationconverters="clr-namespace:SmartSolucionesCuba.XFToolKit.Presentation.Converters;assembly=SmartSolucionesCuba.XFToolKit.Presentation"
    x:Class="SmartSolucionesCuba.Viderhe.Terminal.Dashboard.Pages.ManageProgrammingPage"
    x:TypeArguments="pagemodels:ManageProgrammingPageModel"
    Title="Programación">
    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:TemplateViewModelToTemplateThumbnailWrapViewConverter x:Key="TemplateViewModelToTemplateThumbnailWrapViewConverter" />
            <converters:BoolToManageProgrammingPageLayoutToolbarItemIconConverter x:Key="BoolToManageProgrammingPageLayoutToolbarItemIconConverter" />
            <supportpresentationdashboardconverters:CollectionViewWidthToSelfVerticalGridItemsLayoutConverter x:Key="CollectionViewWidthToSelfVerticalGridItemsLayoutConverter" ChildMinWidth="200" ChildAbsoluteHorizontalMargin="10" />
            <supportpresentationdashboardconverters:AllTrueMultiConverter x:Key="AllTrueMultiConverter" />
            <supportpresentationdashboardconverters:PlacardViewModelToPlacardThumbnailWrapViewConverter x:Key="PlacardViewModelToPlacardThumbnailWrapViewConverter" />
            <supportpresentationdashboardconverters:PlacardToIsAnyPlayerOrientationSupportedConverter x:Key="PlacardToIsAnyPlayerOrientationSupportedConverter" />

            <sscxftoolkitpresentationconverters:IfNullOrEmptyToStringConverter x:Key="IfNullOrEmptyToStringConverter" StringReplacement="Descripción no especificada" />
            <sscxftoolkitpresentationconverters:NullToBooleanConverter x:Key="NullToBooleanConverter" />
            <sscxftoolkitpresentationconverters:NotNullToBooleanConverter x:Key="NotNullToBooleanConverter" />
            <sscxftoolkitpresentationconverters:BoolToBoolNegationConverter x:Key="BoolToBoolNegationConverter" />
            <sscxftoolkitpresentationconverters:EnumerableEmptyToBooleanConverter x:Key="EnumerableEmptyToBooleanConverter" />
            <sscxftoolkitpresentationconverters:EnumerableEmptyToBooleanConverter x:Key="InverseEnumerableEmptyToBooleanConverter" Inverse="True" />
        </ResourceDictionary>
    </ContentPage.Resources>
    <ContentPage.ToolbarItems>
        <ToolbarItem
            Text="Visualización"
            IconImageSource="{Binding Path=UseExpandedLayout, Converter={StaticResource BoolToManageProgrammingPageLayoutToolbarItemIconConverter}}"
            Clicked="ToogleUseLayoutVariantToolbarItem_Clicked" />
        <ToolbarItem
            Text="Actualizar"
            Clicked="ReloadToolbarItem_Clicked">
            <ToolbarItem.IconImageSource>
                <FontImageSource FontFamily="{StaticResource IconFontFamily}" Glyph="&#xf6ea;">
                    <FontImageSource.Color>
                        <OnPlatform x:TypeArguments="Color">
                            <On Platform="UWP" Value="Black" />
                        </OnPlatform>
                    </FontImageSource.Color>
                </FontImageSource>
            </ToolbarItem.IconImageSource>
        </ToolbarItem>
    </ContentPage.ToolbarItems>
    <ContentPage.Content>
        <Grid ColumnSpacing="0" RowSpacing="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="300" />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition />
            </Grid.RowDefinitions>
            <StackLayout
                IsVisible="{Binding Path=UseExpandedLayout, Converter={StaticResource BoolToBoolNegationConverter}}"
                Grid.Column="0" Grid.Row="0"
                Padding="10"
                BackgroundColor="#d3d3d3"
                WidthRequest="240"
                Orientation="Horizontal"
                Spacing="4">
                <Label
                    VerticalOptions="Center" 
                    Text="&#xf411;"
                    FontFamily="{StaticResource IconFontFamily}"
                    FontSize="Large" />
                <Label 
                    VerticalOptions="Center" 
                    HorizontalOptions="FillAndExpand"
                    Text="Guiones"
                    FontSize="Medium" />
                <Button 
                    Text="&#xf415;"
                    Style="{StaticResource TextIconButton}"
                    FontSize="Medium"
                    Clicked="AddScreenplayButton_Clicked" />
            </StackLayout>
            <CollectionView
                IsVisible="{Binding Path=UseExpandedLayout, Converter={StaticResource BoolToBoolNegationConverter}}"
                Grid.Column="0" Grid.Row="1"
                BackgroundColor="White"
                WidthRequest="240"
                ItemsSource="{Binding Path=Screenplays}"
                ItemSizingStrategy="MeasureAllItems"
                SelectionMode="Single"
                SelectionChanged="ScreenplayCollectionView_SelectionChanged">
                <CollectionView.EmptyView>
                    <StackLayout>
                        <Label
                            IsVisible="{Binding Path=IsBusy, Converter={StaticResource BoolToBoolNegationConverter}}"
                            Padding="10"
                            TextColor="DimGray"
                            Text="Sin elementos que mostrar" />
                    </StackLayout>
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Grid 
                            Padding="12,8,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition />
                            </Grid.RowDefinitions>
                            <Label
                                Grid.Column="0" Grid.Row="0"
                                Text="{Binding Path=Title}"
                                LineBreakMode="TailTruncation"
                                MaxLines="2" />
                            <Label 
                                Grid.Column="0" Grid.Row="1"
                                Text="{Binding Path=About, Converter={StaticResource IfNullOrEmptyToStringConverter}}"
                                TextColor="DimGray"
                                LineBreakMode="TailTruncation"
                                MaxLines="2"
                                FontSize="Caption" />
                            <Button 
                                Grid.Column="1" Grid.RowSpan="2"
                                VerticalOptions="Center"
                                Style="{StaticResource OptionsTextIconButton}"
                                Padding="0"
                                WidthRequest="24" HeightRequest="30"
                                Text="&#xF1D9;"
                                FontSize="Medium"
                                Clicked="ScreenplayOptionsButton_Clicked" />
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
            <StackLayout
                Grid.Column="1" Grid.Row="0"
                Padding="10"
                Orientation="Horizontal"
                BackgroundColor="#bdbdbd"
                Spacing="4">
                <Label
                    VerticalOptions="Center" 
                    Text="&#xf328;"
                    FontFamily="{StaticResource IconFontFamily}"
                    FontSize="Large" />
                <Label 
                    VerticalOptions="Center" 
                    HorizontalOptions="FillAndExpand"
                    Text="Secuencia"
                    FontSize="Medium" />
                <Button 
                    IsEnabled="{Binding Path=Frames, Converter={StaticResource InverseEnumerableEmptyToBooleanConverter}}"
                    Text="&#xf40a;"
                    Style="{StaticResource TextIconButton}"
                    FontSize="Medium"
                    Clicked="ScreenplayFramesPlayButton_Clicked" />
            </StackLayout>
            <Grid                
                Grid.Column="1" Grid.Row="1"
                BackgroundColor="#EAEAEA">
                <CollectionView                     
                    Margin="0,4"
                    ItemsSource="{Binding Path=Frames}">
                    <CollectionView.EmptyView>
                        <StackLayout>
                            <Label
                                Margin="10,8"
                                BindingContext="{x:Reference Name=UnselectedScreenplayInticatorViewGroup}"
                                IsVisible="{Binding IsVisible, Converter={StaticResource BoolToBoolNegationConverter}}"
                                Text="Sin elementos que mostrar"
                                TextColor="DimGray" />
                        </StackLayout>
                    </CollectionView.EmptyView>
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <ContentView>
                                <Grid
                                    Margin="8,4,0,4"
                                    BackgroundColor="#F5F5F5"
                                    ColumnSpacing="8"
                                    HeightRequest="96">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid
                                        Grid.Column="0"             
                                        Margin="1,0"
                                        WidthRequest="96">
                                        <BoxView Color="LightGray" />
                                        <Label
                                            IsVisible="{Binding Path=Placard, Converter={StaticResource PlacardToIsAnyPlayerOrientationSupportedConverter}}"
                                            HorizontalOptions="End" VerticalOptions="Start"
                                            Margin="3"
                                            Text="&#xf884;"
                                            TextColor="Black"
                                            FontFamily="Material Design Icons" />
                                        <ContentView Content="{Binding Path=Placard.Template, Converter={StaticResource TemplateViewModelToTemplateThumbnailWrapViewConverter}}" />
                                    </Grid>
                                    <Label
                                        Grid.Column="1"
                                        Text="{Binding Path=Placard.Label}"
                                        TextColor="Black"
                                        FontSize="Caption"
                                        VerticalTextAlignment="Center"
                                        LineBreakMode="TailTruncation"
                                        MaxLines="4" />
                                    <Button 
                                        Grid.Column="2"
                                        VerticalOptions="Center"
                                        Style="{StaticResource OptionsTextIconButton}"
                                        Padding="0,6"
                                        Text="&#xF1D9;"
                                        FontSize="Medium"
                                        Clicked="FrameOverviewOptionsButton_Clicked" />
                                </Grid>
                            </ContentView>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </Grid>
            <StackLayout
                x:Name="UnselectedScreenplayInticatorViewGroup"
                Grid.Column="1" Grid.Row="1"
                IsVisible="{Binding Path=SelectedScreenplay, Converter={StaticResource NullToBooleanConverter}}">
                <Label
                    HorizontalOptions="CenterAndExpand"
                    VerticalOptions="CenterAndExpand"
                    HorizontalTextAlignment="Center"
                    Margin="30"
                    TextColor="{StaticResource PrimaryColor}"
                    Text="Seleccione el guion para gestionar secuencia de marcos" />
            </StackLayout>
            <StackLayout
                Grid.Column="2" Grid.Row="0"
                Padding="10"
                Orientation="Horizontal"
                BackgroundColor="#a4a4a4"
                Spacing="4">
                <Label
                    VerticalOptions="Center" 
                    Text="&#xf0e5;"
                    FontFamily="{StaticResource IconFontFamily}"
                    FontSize="Large" />
                <Label 
                    VerticalOptions="Center" 
                    HorizontalOptions="FillAndExpand"
                    Text="Marcos"
                    FontSize="Medium" />
                <Button 
                    Text="&#xf415;"
                    Style="{StaticResource TextIconButton}"
                    FontSize="Medium"
                    Clicked="AddPlacardButton_Clicked" />
            </StackLayout>
            <supportpresentationdashboardviews:BackgroundView 
                Grid.Column="2" Grid.Row="1" />
            <StackLayout 
                Grid.Column="2" Grid.Row="1"
                Spacing="0">
                <ContentView SizeChanged="PlacardOverviewCollectionWrapperView_SizeChanged">
                    <CollectionView
                        x:Name="PlacardOverviewCollectionView"
                        ItemsLayout="{Binding Source={x:Reference PlacardOverviewCollectionView}, Path=Width, Converter={StaticResource CollectionViewWidthToSelfVerticalGridItemsLayoutConverter}}"
                        ItemsSource="{Binding Path=PlacardOverviews}"
                        SelectionMode="None"
                        Scrolled="PlacardOverviewCollectionView_Scrolled">
                        <CollectionView.Margin>
                            <OnPlatform x:TypeArguments="Thickness" Default="5,5,5,0">
                                <On Platform="Android" Value="10,10,10,0" />
                            </OnPlatform>
                        </CollectionView.Margin>
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Grid RowSpacing="0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid 
                                        Grid.Row="0"
                                        HeightRequest="{Binding Source={RelativeSource AncestorType={Type Grid}}, Path=Width}">
                                        <BoxView Color="White" Opacity="0.2" />
                                        <ContentView Content="{Binding Path=Placard, Converter={StaticResource PlacardViewModelToPlacardThumbnailWrapViewConverter}}" />
                                        <Label
                                            IsVisible="{Binding Path=Placard, Converter={StaticResource PlacardToIsAnyPlayerOrientationSupportedConverter}}"
                                            HorizontalOptions="Start" VerticalOptions="End"
                                            BackgroundColor="{StaticResource PrimaryColor}"
                                            Padding="4"
                                            Text="&#xf884;"
                                            TextColor="White"
                                            FontFamily="Material Design Icons"
                                            FontSize="24" />
                                        <Button 
                                            HorizontalOptions="End" VerticalOptions="Start"
                                            Padding="0,6"
                                            Text="&#xF1D9;"
                                            Style="{StaticResource OptionsTextIconButton}"
                                            FontSize="Medium"
                                            Clicked="PlacardOverviewOptionsButton_Clicked" />
                                    </Grid>
                                    <StackLayout 
                                        Grid.Row="1"
                                        BackgroundColor="White"
                                        Spacing="0">
                                        <Label
                                            Margin="8,8,8,4"
                                            Text="{Binding Path=Placard.Label}"
                                            LineBreakMode="TailTruncation" />
                                        <Label 
                                            VerticalOptions="Center"
                                            Margin="8,0,0,8"
                                            Text="{Binding Path=Placard.Template.Name}"
                                            LineBreakMode="TailTruncation"
                                            TextColor="DimGray"
                                            FontSize="Caption" />
                                    </StackLayout>
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </ContentView>
                <StackLayout BackgroundColor="#9fa9b6">
                    <Button
                        HorizontalOptions="Center"
                        Margin="8"
                        Text="Mostrar más"
                        Clicked="LoadNextPlacardsPageButtton_Clicked">
                        <Button.IsEnabled>
                            <MultiBinding Converter="{StaticResource AllTrueMultiConverter}">
                                <Binding Path="HasMorePlacards" />
                                <Binding Path="IsBusy" Converter="{StaticResource BoolToBoolNegationConverter}" />
                            </MultiBinding>
                        </Button.IsEnabled>
                        <Button.HeightRequest>
                            <OnPlatform x:TypeArguments="x:Double" Default="-1">
                                <On Platform="UWP" Value="40" />
                                <On Platform="Android" Value="52" />
                            </OnPlatform>
                        </Button.HeightRequest>
                    </Button>
                </StackLayout>
            </StackLayout>
            <StackLayout
                Grid.Column="2" Grid.Row="1">
                <StackLayout.IsVisible>
                    <MultiBinding Converter="{StaticResource AllTrueMultiConverter}">
                        <Binding Path="PlacardOverviews" Converter="{StaticResource EnumerableEmptyToBooleanConverter}" />
                        <Binding Path="IsBusy" Converter="{StaticResource BoolToBoolNegationConverter}" />
                    </MultiBinding>
                </StackLayout.IsVisible>
                <Label
                    Margin="10"
                    Text="Sin elementos que mostrar"
                    TextColor="Black">
                </Label>
            </StackLayout>
            <supportpresentationdashboardviews:BusyView Grid.ColumnSpan="3" Grid.RowSpan="2" />
        </Grid>
    </ContentPage.Content>
</sscxftoolkitmvvmpages:BindingContextedContentPage>