<?xml version="1.0" encoding="utf-8" ?>
<sscxftoolkitmvvmpages:BindingContextedContentPage 
    xmlns="http://xamarin.com/schemas/2014/forms"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:d="http://xamarin.com/schemas/2014/forms/design"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:supportpresentationdashboardviews="clr-namespace:SmartSolucionesCuba.Viderhe.Support.Presentation.Dashboard.Views;assembly=SmartSolucionesCuba.Viderhe.Support.Presentation.Dashboard"
    xmlns:pagemodels="clr-namespace:SmartSolucionesCuba.Viderhe.Terminal.Dashboard.Models.Page"
    xmlns:sscxftoolkitmvvmpages="clr-namespace:SmartSolucionesCuba.XFToolKit.Mvvm.Pages;assembly=SmartSolucionesCuba.XFToolKit.Mvvm"
    xmlns:sscxftoolkitpresentationconverters="clr-namespace:SmartSolucionesCuba.XFToolKit.Presentation.Converters;assembly=SmartSolucionesCuba.XFToolKit.Presentation"
    xmlns:simplecolorpicker="clr-namespace:Xam.Plugin.SimpleColorPicker;assembly=Xam.Plugin.SimpleColorPicker"
    xmlns:ffimageloadingforms="clr-namespace:FFImageLoading.Forms;assembly=FFImageLoading.Forms"
    mc:Ignorable="d"
    x:Class="SmartSolucionesCuba.Viderhe.Terminal.Dashboard.Pages.AccountIdentityConfigurationPage"
    x:TypeArguments="pagemodels:AccountIdentityConfigurationPageModel"
    Title="Configuración de Cuenta">
    <ContentPage.Resources>
        <ResourceDictionary>
            <sscxftoolkitpresentationconverters:FractionConverter x:Key="FractionConverter" />
            <sscxftoolkitpresentationconverters:NotNullToBooleanConverter x:Key="NotNullToBooleanConverter" />

            <Style TargetType="Frame">
                <Setter Property="HasShadow" Value="False" />
            </Style>
        </ResourceDictionary>
    </ContentPage.Resources>
    <ContentPage.ToolbarItems>
        <ToolbarItem 
            Text="Aplicar"
            Activated="ApplyToolbarItem_Activated">
            <ToolbarItem.IconImageSource>
                <FontImageSource FontFamily="{StaticResource ToolbarIconFontFamily}" Glyph="&#xf12c;">
                    <FontImageSource.Color>
                        <OnPlatform x:TypeArguments="Color">
                            <On Platform="UWP" Value="Black" />
                        </OnPlatform>
                    </FontImageSource.Color>
                </FontImageSource>
            </ToolbarItem.IconImageSource>
        </ToolbarItem>
        <ToolbarItem 
            Text="Cancelar"
            Activated="CancelToolbarItem_Activated">
            <ToolbarItem.IconImageSource>
                <FontImageSource FontFamily="{StaticResource ToolbarIconFontFamily}" Glyph="&#xf156;">
                    <FontImageSource.Color>
                        <OnPlatform x:TypeArguments="Color">
                            <On Platform="UWP" Value="Black" />
                        </OnPlatform>
                    </FontImageSource.Color>
                </FontImageSource>
            </ToolbarItem.IconImageSource>
        </ToolbarItem>
    </ContentPage.ToolbarItems>
    <ContentPage.Content>
        <Grid>
            <supportpresentationdashboardviews:BackgroundView />
            <ScrollView>
                <Grid 
                    Margin="10"
                    ColumnSpacing="10" RowSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition />
                        <ColumnDefinition />
                        <ColumnDefinition />
                        <ColumnDefinition />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Frame Grid.ColumnSpan="6" Grid.Row="0" Style="{StaticResource FormFieldFrame}">
                        <StackLayout>
                            <Label Text="Nombre" Style="{StaticResource FormLabel}" />
                            <Entry Text="{Binding Path=Name}" />
                        </StackLayout>
                    </Frame>
                    <Frame Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="1" Style="{StaticResource FormFieldFrame}">
                        <StackLayout>
                            <Label Text="Color Primario" Style="{StaticResource FormLabel}" />
                            <simplecolorpicker:ColorPickerEntry 
                                EditAlfa="False"
                                Color="{Binding Path=PrimaryColor}"/>
                        </StackLayout>
                    </Frame>
                    <Frame Grid.Column="2" Grid.ColumnSpan="2" Grid.Row="1" Style="{StaticResource FormFieldFrame}">
                        <StackLayout>
                            <Label Text="Color Secundario" Style="{StaticResource FormLabel}" />
                            <simplecolorpicker:ColorPickerEntry 
                                EditAlfa="False"
                                Color="{Binding Path=SecoundaryColor}"/>
                        </StackLayout>
                    </Frame>
                    <Frame Grid.Column="4" Grid.ColumnSpan="2" Grid.Row="1" Style="{StaticResource FormFieldFrame}">
                        <StackLayout>
                            <Label Text="Caratula" Style="{StaticResource FormLabel}" />
                            <StackLayout Orientation="Horizontal">
                                <Picker
                                    x:Name="OverlayPicker"
                                    HorizontalOptions="FillAndExpand"
                                    ItemsSource="{Binding Path=AvailableOverlays}"
                                    ItemDisplayBinding="{Binding Path=Name}"
                                    SelectedIndexChanged="OverlayPicker_SelectedIndexChanged"/>
                                <Button 
                                    IsEnabled="{Binding Source={x:Reference OverlayPicker}, Path=SelectedItem, Converter={StaticResource NotNullToBooleanConverter}}"
                                    FontFamily="{StaticResource IconFontFamily}"
                                    Text="&#xf493;"
                                    Clicked="OverlayConfigureButton_Clicked" />
                                <Button 
                                    IsEnabled="{Binding Source={x:Reference OverlayPicker}, Path=SelectedItem, Converter={StaticResource NotNullToBooleanConverter}}"
                                    FontFamily="{StaticResource IconFontFamily}"
                                    Text="&#xF413;"
                                    Clicked="SelectedOverlayClearButton_Clicked" />
                            </StackLayout>
                        </StackLayout>
                    </Frame>
                    <Frame 
                        Style="{StaticResource FormFieldFrame}"
                        Grid.Column="0" Grid.Row="2"
                        Padding="0"
                        VerticalOptions="Start">
                        <StackLayout 
                            VerticalOptions="FillAndExpand"
                            Spacing="0">
                            <Label 
                                Margin="10,10,10,6"
                                Text="Logotipo" 
                                Style="{StaticResource FormLabel}" />
                            <BoxView BackgroundColor="#666666" HeightRequest="1" />
                            <Grid>
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="PickLogoImageButton_Clicked" />
                                </Grid.GestureRecognizers>
                                <ffimageloadingforms:CachedImage 
                                    BackgroundColor="White"
                                    HeightRequest="{Binding Source={RelativeSource Mode=Self}, Path=Width}"
                                    Source="{Binding Path=LogoImageSource}"
                                    Aspect="AspectFill"
                                    CacheType="Disk"
                                    CacheDuration="8760:00:00" />
                                <StackLayout 
                                    HorizontalOptions="Center" VerticalOptions="End"
                                    Padding="4"
                                    BackgroundColor="#99000000"
                                    Orientation="Horizontal">
                                    <Label
                                        Text="&#xf740;"
                                        TextColor="White"
                                        FontFamily="{StaticResource IconFontFamily}"
                                        FontSize="Medium" />
                                    <Label
                                        VerticalOptions="Center"
                                        Margin="0,0,4,0"
                                        Text="para modificar"
                                        TextColor="White"
                                        LineBreakMode="TailTruncation" />
                                </StackLayout>
                            </Grid>
                        </StackLayout>
                    </Frame>
                    <Frame 
                        Style="{StaticResource FormFieldFrame}"
                        Grid.Column="1" Grid.ColumnSpan="2" Grid.Row="2"
                        Padding="0"
                        VerticalOptions="Start">
                        <StackLayout 
                            VerticalOptions="FillAndExpand"
                            Spacing="0">
                            <Label 
                                Margin="10,10,10,6"
                                Text="Portada Vertical" 
                                Style="{StaticResource FormLabel}" />
                            <BoxView BackgroundColor="#666666" HeightRequest="1" />
                            <Grid>
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="PickVerticalSplashImageButton_Clicked" />
                                </Grid.GestureRecognizers>
                                <ffimageloadingforms:CachedImage 
                                    BackgroundColor="White"
                                    HeightRequest="{Binding Source={x:RelativeSource Mode=Self}, Path=Width, Converter={StaticResource FractionConverter}, ConverterParameter=0.5625}"
                                    Source="{Binding Path=VerticalSplashImageSource}"
                                    Aspect="AspectFill"
                                    CacheType="Disk"
                                    CacheDuration="8760:00:00" />
                                <StackLayout 
                                    HorizontalOptions="Center" VerticalOptions="End"
                                    Padding="4"
                                    BackgroundColor="#99000000"
                                    Orientation="Horizontal">
                                    <Label
                                        Text="&#xf740;"
                                        TextColor="White"
                                        FontFamily="{StaticResource IconFontFamily}"
                                        FontSize="Medium" />
                                    <Label
                                        VerticalOptions="Center"
                                        Margin="0,0,4,0"
                                        Text="para modificar"
                                        TextColor="White"
                                        LineBreakMode="TailTruncation" />
                                </StackLayout>
                            </Grid>
                        </StackLayout>
                    </Frame>
                    <Frame 
                        Style="{StaticResource FormFieldFrame}"
                        Grid.Column="3" Grid.ColumnSpan="3" Grid.Row="2"
                        Padding="0"
                        VerticalOptions="Start">
                        <StackLayout 
                            VerticalOptions="FillAndExpand"
                            Spacing="0">
                            <Label 
                                Margin="10,10,10,6"
                                Text="Portada Horizontal" 
                                Style="{StaticResource FormLabel}" />
                            <BoxView BackgroundColor="#666666" HeightRequest="1" />
                            <Grid>
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="PickHorizontalSplashImageButton_Clicked" />
                                </Grid.GestureRecognizers>
                                <ffimageloadingforms:CachedImage 
                                    BackgroundColor="White"
                                    HeightRequest="{Binding Source={x:RelativeSource Mode=Self}, Path=Width, Converter={StaticResource FractionConverter}, ConverterParameter=1.777777777777778}"
                                    Source="{Binding Path=HorizontalSplashImageSource}"
                                    Aspect="AspectFill"
                                    CacheType="Disk"
                                    CacheDuration="8760:00:00" />
                                <StackLayout 
                                    HorizontalOptions="Center" VerticalOptions="End"
                                    Padding="4"
                                    BackgroundColor="#99000000"
                                    Orientation="Horizontal">
                                    <Label
                                        Text="&#xf740;"
                                        TextColor="White"
                                        FontFamily="{StaticResource IconFontFamily}"
                                        FontSize="Medium" />
                                    <Label
                                        VerticalOptions="Center"
                                        Margin="0,0,4,0"
                                        Text="para modificar"
                                        TextColor="White"
                                        LineBreakMode="TailTruncation" />
                                </StackLayout>
                            </Grid>
                        </StackLayout>
                    </Frame>
                </Grid>
            </ScrollView>
            <supportpresentationdashboardviews:BusyView />
        </Grid>
    </ContentPage.Content>
</sscxftoolkitmvvmpages:BindingContextedContentPage>