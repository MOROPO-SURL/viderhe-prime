<?xml version="1.0" encoding="utf-8" ?>
<sscxftoolkitmvvmpages:BindingContextedContentPage 
    xmlns="http://xamarin.com/schemas/2014/forms"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:pagemodels="clr-namespace:SmartSolucionesCuba.Viderhe.Support.Presentation.Dashboard.Models.Page"
    xmlns:converters="clr-namespace:SmartSolucionesCuba.Viderhe.Support.Presentation.Dashboard.Converters"
    xmlns:supportpresentationdashboardviews="clr-namespace:SmartSolucionesCuba.Viderhe.Support.Presentation.Dashboard.Views;assembly=SmartSolucionesCuba.Viderhe.Support.Presentation.Dashboard"
    xmlns:sscxftoolkitmvvmpages="clr-namespace:SmartSolucionesCuba.XFToolKit.Mvvm.Pages;assembly=SmartSolucionesCuba.XFToolKit.Mvvm"
    xmlns:sscxftoolkitpresentationconverters="clr-namespace:SmartSolucionesCuba.XFToolKit.Presentation.Converters;assembly=SmartSolucionesCuba.XFToolKit.Presentation"
    x:Class="SmartSolucionesCuba.Viderhe.Support.Presentation.Dashboard.Pages.PlacardPickPage"
    x:TypeArguments="pagemodels:PlacardPickPageModel"
    Title="Seleccionar Cartel">
    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:PlacardViewModelToPlacardThumbnailWrapViewConverter x:Key="PlacardViewModelToPlacardThumbnailWrapViewConverter" />
            <converters:PlacardToIsAnyPlayerOrientationSupportedConverter x:Key="PlacardToIsAnyPlayerOrientationSupportedConverter" />
            <converters:CollectionViewWidthToSelfVerticalGridItemsLayoutConverter x:Key="CollectionViewWidthToSelfVerticalGridItemsLayoutConverter" ChildMinWidth="200" ChildAbsoluteHorizontalMargin="10" />
            <converters:AllTrueMultiConverter x:Key="AllTrueMultiConverter" />

            <sscxftoolkitpresentationconverters:BoolToBoolNegationConverter x:Key="BoolToBoolNegationConverter" />
            <sscxftoolkitpresentationconverters:EnumerableEmptyToBooleanConverter x:Key="EnumerableEmptyToBooleanConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>
    <ContentPage.Content>
        <Grid>
            <supportpresentationdashboardviews:BackgroundView />
            <StackLayout>
                <ContentView SizeChanged="PlacardOverviewCollectionWrapperView_SizeChanged">
                    <CollectionView
                        x:Name="PlacardOverviewCollectionView"
                        ItemsLayout="{Binding Source={x:Reference PlacardOverviewCollectionView}, Path=Width, Converter={StaticResource CollectionViewWidthToSelfVerticalGridItemsLayoutConverter}}"
                        ItemsSource="{Binding Path=Items}"
                        SelectionMode="None"
                        Scrolled="PlacardOverviewCollectionView_Scrolled">
                        <CollectionView.Margin>
                            <OnPlatform x:TypeArguments="Thickness" Default="5,5,5,0">
                                <On Platform="Android" Value="10,10,10,0" />
                            </OnPlatform>
                        </CollectionView.Margin>
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Grid RowSpacing="0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid 
                                        Grid.Row="0"
                                        HeightRequest="{Binding Source={RelativeSource AncestorType={Type Grid}}, Path=Width}">
                                        <BoxView Color="White" Opacity="0.2" />
                                        <ContentView Content="{Binding Path=Placard, Converter={StaticResource PlacardViewModelToPlacardThumbnailWrapViewConverter}}" />
                                        <Label
                                            IsVisible="{Binding Path=Placard, Converter={StaticResource PlacardToIsAnyPlayerOrientationSupportedConverter}}"
                                            HorizontalOptions="Start" VerticalOptions="End"
                                            BackgroundColor="{StaticResource PrimaryColor}"
                                            Padding="4"
                                            Text="&#xf884;"
                                            TextColor="White"
                                            FontFamily="Material Design Icons"
                                            FontSize="24" />
                                    </Grid>
                                    <StackLayout 
                                        Grid.Row="1"
                                        BackgroundColor="White"
                                        Spacing="0">
                                        <Label
                                            Margin="8,8,8,4"
                                            Text="{Binding Path=Placard.Label}"
                                            LineBreakMode="TailTruncation" />
                                        <Label 
                                            VerticalOptions="Center"
                                            Margin="8,0,0,8"
                                            Text="{Binding Path=Placard.Template.Name}"
                                            LineBreakMode="TailTruncation"
                                            TextColor="DimGray"
                                            FontSize="Caption" />
                                        <Button 
                                            BackgroundColor="Accent"
                                            Text="Seleccionar"
                                            TextColor="White"
                                            Clicked="PlacardOverviewPickButton_Clicked" />
                                    </StackLayout>
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </ContentView>
                <StackLayout BackgroundColor="#9fa9b6">
                    <Button
                        HorizontalOptions="Center"
                        Margin="8"
                        Text="Mostrar más"
                        Clicked="LoadNextPageButton_Clicked">
                        <Button.IsEnabled>
                            <MultiBinding Converter="{StaticResource AllTrueMultiConverter}">
                                <Binding Path="HasMoreItems" />
                                <Binding Path="IsBusy" Converter="{StaticResource BoolToBoolNegationConverter}" />
                            </MultiBinding>
                        </Button.IsEnabled>
                        <Button.HeightRequest>
                            <OnPlatform x:TypeArguments="x:Double" Default="-1">
                                <On Platform="UWP" Value="40" />
                                <On Platform="Android" Value="52" />
                            </OnPlatform>
                        </Button.HeightRequest>
                    </Button>
                </StackLayout>
            </StackLayout>
            <StackLayout>
                <StackLayout.IsVisible>
                    <MultiBinding Converter="{StaticResource AllTrueMultiConverter}">
                        <Binding Path="Items" Converter="{StaticResource EnumerableEmptyToBooleanConverter}" />
                        <Binding Path="IsBusy" Converter="{StaticResource BoolToBoolNegationConverter}" />
                    </MultiBinding>
                </StackLayout.IsVisible>
                <Label
                    Margin="10"
                    Text="Sin elementos que mostrar"
                    TextColor="Black">
                </Label>
            </StackLayout>
            <supportpresentationdashboardviews:BusyView />
        </Grid>
    </ContentPage.Content>
</sscxftoolkitmvvmpages:BindingContextedContentPage>