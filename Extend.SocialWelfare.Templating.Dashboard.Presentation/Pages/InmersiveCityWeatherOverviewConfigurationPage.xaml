<?xml version="1.0" encoding="utf-8" ?>
<sscxftoolkitmvvmpages:BindingContextedContentPage 
    xmlns="http://xamarin.com/schemas/2014/forms"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:d="http://xamarin.com/schemas/2014/forms/design"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:pagemodels="clr-namespace:SmartSolucionesCuba.Viderhe.Extend.SocialWelfare.Templating.Dashboard.Presentation.Models.Page"
    xmlns:supportpresentationdashboardviews="clr-namespace:SmartSolucionesCuba.Viderhe.Support.Presentation.Dashboard.Views;assembly=SmartSolucionesCuba.Viderhe.Support.Presentation.Dashboard"
    xmlns:sscxftoolkitmvvmpages="clr-namespace:SmartSolucionesCuba.XFToolKit.Mvvm.Pages;assembly=SmartSolucionesCuba.XFToolKit.Mvvm"
    xmlns:sscxftoolkitpresentationconverters="clr-namespace:SmartSolucionesCuba.XFToolKit.Presentation.Converters;assembly=SmartSolucionesCuba.XFToolKit.Presentation"
    xmlns:ffimageloadingforms="clr-namespace:FFImageLoading.Forms;assembly=FFImageLoading.Forms"
    mc:Ignorable="d"
    x:Class="SmartSolucionesCuba.Viderhe.Extend.SocialWelfare.Templating.Dashboard.Presentation.Pages.InmersiveCityWeatherOverviewConfigurationPage"
    x:TypeArguments="pagemodels:InmersiveCityWeatherOverviewConfigurationPageModel">
    <ContentPage.Resources>
        <ResourceDictionary>
            <Style TargetType="Frame">
                <Setter Property="BackgroundColor" Value="White" />
                <Setter Property="HasShadow" Value="False" />
                <Setter Property="CornerRadius" Value="0" />
                <Setter Property="Padding" Value="12" />
            </Style>
            <sscxftoolkitpresentationconverters:FractionConverter x:Key="FractionConverter" />
            <sscxftoolkitpresentationconverters:NotNullToBooleanConverter x:Key="NotNullToBooleanConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>
    <ContentPage.ToolbarItems>
        <ToolbarItem 
            Text="Aplicar"
            Clicked="ApplyToolbarItem_Clicked">
            <ToolbarItem.IconImageSource>
                <FontImageSource FontFamily="{StaticResource ToolbarIconFontFamily}" Glyph="&#xf12c;">
                    <FontImageSource.Color>
                        <OnPlatform x:TypeArguments="Color">
                            <On Platform="UWP" Value="Black" />
                        </OnPlatform>
                    </FontImageSource.Color>
                </FontImageSource>
            </ToolbarItem.IconImageSource>
        </ToolbarItem>
        <ToolbarItem 
            Text="Cancelar"
            Clicked="CancelToolbarItem_Clicked">
            <ToolbarItem.IconImageSource>
                <FontImageSource FontFamily="{StaticResource ToolbarIconFontFamily}" Glyph="&#xf156;">
                    <FontImageSource.Color>
                        <OnPlatform x:TypeArguments="Color">
                            <On Platform="UWP" Value="Black" />
                        </OnPlatform>
                    </FontImageSource.Color>
                </FontImageSource>
            </ToolbarItem.IconImageSource>
        </ToolbarItem>
    </ContentPage.ToolbarItems>
    <ContentPage.Content>
        <Grid>
            <supportpresentationdashboardviews:BackgroundView />
            <ScrollView>
                <Grid 
                    Margin="10"
                    ColumnSpacing="10" RowSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Frame Grid.ColumnSpan="3" Grid.Row="0">
                        <StackLayout>
                            <Label Text="Etiqueta" Style="{StaticResource FormLabel}" />
                            <Entry Text="{Binding Path=Label}" />
                        </StackLayout>
                    </Frame>
                    <Frame Grid.Column="0" Grid.Row="1">
                        <StackLayout>
                            <Label
                                Style="{StaticResource FormLabel}"
                                Text="Servidor Viderhe Weather" />
                            <StackLayout Orientation="Horizontal">
                                <Entry 
                                    HorizontalOptions="FillAndExpand"
                                    BackgroundColor="LightGray"
                                    Text="{Binding Path=WeatherCacheMicroServerHost}"
                                    Placeholder="Ej: weather.viderhe.net"
                                    IsReadOnly="True" />
                                <Button 
                                    FontFamily="{StaticResource IconFontFamily}"
                                    Text="&#xf90b;"
                                    Clicked="SetWeatherCacheMicroServerHostButton_Clicked" />
                            </StackLayout>
                        </StackLayout>
                    </Frame>
                    <Frame Grid.Column="1" Grid.Row="1">
                        <StackLayout>
                            <Label Text="Servidor Usa Conexión Segura" Style="{StaticResource FormLabel}" />
                            <Switch IsToggled="{Binding Path=IsWeatherCacheMicroServerRequireSecureConnection}" />
                        </StackLayout>
                    </Frame>
                    <Frame Grid.Column="2" Grid.Row="1">
                        <StackLayout>
                            <Label Text="Servidor Con Seguridad Estricta" Style="{StaticResource FormLabel}" />
                            <Switch 
                                IsEnabled="{Binding Path=IsWeatherCacheMicroServerRequireSecureConnection}"
                                IsToggled="{Binding Path=IsWeatherCacheMicroServerSecureConnectionStrict}" />
                        </StackLayout>
                    </Frame>
                    <Frame Grid.Column="0" Grid.Row="2">
                        <StackLayout>
                            <Label Text="Servicio" Style="{StaticResource FormLabel}" />
                            <Picker
                                IsEnabled="{Binding Path=WeatherCacheMicroServerHost, Converter={StaticResource NotNullToBooleanConverter}}"
                                SelectedItem="{Binding Path=Service}"
                                ItemsSource="{Binding Path=AvailableServices}" />
                        </StackLayout>
                    </Frame>
                    <Frame Grid.Column="1" Grid.ColumnSpan="2" Grid.Row="2">
                        <StackLayout>
                            <Label Text="Ciudad" Style="{StaticResource FormLabel}" />
                            <Picker
                                x:Name="CityPicker"
                                IsEnabled="{Binding Path=WeatherCacheMicroServerHost, Converter={StaticResource NotNullToBooleanConverter}}"
                                ItemsSource="{Binding Path=AvailableCities}"
                                ItemDisplayBinding="{Binding Path=Name}"
                                SelectedIndexChanged="CityPicker_SelectedIndexChanged"/>
                        </StackLayout>
                    </Frame>
                    <Frame 
                        Grid.Column="0" Grid.Row="3"
                        Padding="0"
                        VerticalOptions="Start">
                        <StackLayout>
                            <Label
                                Margin="12,12,12,0"
                                Text="Imagen de Fondo" 
                                Style="{StaticResource FormLabel}" />
                            <Grid HeightRequest="{Binding Source={x:RelativeSource Mode=Self}, Path=Width, Converter={StaticResource FractionConverter}, ConverterParameter=1.777777777777778}">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="BackgroundImageGestureRecognizer_Tapped" />
                                </Grid.GestureRecognizers>
                                <ffimageloadingforms:CachedImage 
                                    BackgroundColor="Black"
                                    CacheType="Disk"
                                    CacheDuration="8760:00:00"
                                    Source="{Binding Path=BackgroundCityImage, Converter={StaticResource ImageViewModelToImageSourceConverter}}" />
                                <StackLayout 
                                    HorizontalOptions="Center" VerticalOptions="End"
                                    Padding="4"
                                    BackgroundColor="#99000000"
                                    Orientation="Horizontal">
                                    <Label
                                        Text="&#xf740;"
                                        TextColor="White"
                                        FontFamily="{StaticResource IconFontFamily}"
                                        FontSize="Medium" />
                                    <Label
                                        VerticalOptions="Center"
                                        Margin="0,0,4,0"
                                        Text="para modificar"
                                        TextColor="White"
                                        LineBreakMode="TailTruncation" />
                                </StackLayout>
                            </Grid>
                        </StackLayout>
                    </Frame>
                    <Frame 
                        Grid.Column="1" Grid.Row="3"
                        VerticalOptions="Start">
                        <StackLayout>
                            <Label Text="Tiempo en Pantalla" Style="{StaticResource FormLabel}" />
                            <StackLayout Orientation="Horizontal">
                                <Label Text="{Binding Path=ScreenPresentationTimeSecounds}" VerticalTextAlignment="Center" />
                                <Label Text="Segundos" HorizontalOptions="StartAndExpand" VerticalTextAlignment="Center" />
                                <Stepper Value="{Binding Path=ScreenPresentationTimeSecounds}" />
                            </StackLayout>
                        </StackLayout>
                    </Frame>
                    <Frame 
                        Grid.Column="2" Grid.Row="3"
                        VerticalOptions="Start">
                        <StackLayout>
                            <Label Text="A Pantalla Completa" Style="{StaticResource FormLabel}" />
                            <Switch IsToggled="{Binding Path=RequireUnobstructedPresetation}" />
                        </StackLayout>
                    </Frame>
                </Grid>
            </ScrollView>
            <supportpresentationdashboardviews:BusyView />
        </Grid>
    </ContentPage.Content>
</sscxftoolkitmvvmpages:BindingContextedContentPage>