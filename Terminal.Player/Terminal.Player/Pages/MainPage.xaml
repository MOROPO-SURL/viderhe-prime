<?xml version="1.0" encoding="utf-8" ?>
<ContentPage 
    xmlns="http://xamarin.com/schemas/2014/forms"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:renderedviews="clr-namespace:SmartSolucionesCuba.Viderhe.Terminal.Player.Views.Rendered"
    xmlns:supportpresentationhelpers="clr-namespace:SmartSolucionesCuba.Viderhe.Support.Presentation.Helpers;assembly=SmartSolucionesCuba.Viderhe.Support.Presentation"
    xmlns:supportpresentationviews="clr-namespace:SmartSolucionesCuba.Viderhe.Support.Presentation.Views;assembly=SmartSolucionesCuba.Viderhe.Support.Presentation"
    xmlns:sscxftoolkitpresentationconverters="clr-namespace:SmartSolucionesCuba.XFToolKit.Presentation.Converters;assembly=SmartSolucionesCuba.XFToolKit.Presentation"
    xmlns:ffimageloadingsvg="clr-namespace:FFImageLoading.Svg.Forms;assembly=FFImageLoading.Svg.Forms"
    x:Class="SmartSolucionesCuba.Viderhe.Terminal.Player.Pages.MainPage">
    <ContentPage.Resources>
        <ResourceDictionary>
            <sscxftoolkitpresentationconverters:FractionConverter x:Key="FractionConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>
    <ContentPage.Content>
        <Grid>
            <supportpresentationviews:IdentityBackgroundView />
            <Grid Margin="{Binding Source={x:RelativeSource AncestorType={x:Type ContentPage}}, Path=Width, Converter={StaticResource FractionConverter}, ConverterParameter=20}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Label
                    x:Name="StepTitleLabel"
                    Grid.Column="0" Grid.Row="0"
                    Opacity="0"
                    Text="{Binding Path=Title}"
                    TextColor="White"
                    FontSize="{Static supportpresentationhelpers:StaticResourceProvisioningHelper.LargeTitleTextFontSize}" />
                <renderedviews:IndeterminableProgressBarView
                    x:Name="CurrentTaskProgressBar"
                    Grid.ColumnSpan="2" Grid.Row="1"
                    Opacity="0"
                    Margin="0,30"
                    ProgressColor="White"
                    HeightRequest="20" />
                <ContentView 
                    x:Name="StepDetailContentView"
                    Content="{Binding Path=DetailContentView}"
                    Grid.ColumnSpan="2" Grid.Row="2" />
                <StackLayout 
                    x:Name="ProductIdentityContainer"
                    Grid.Column="1" Grid.RowSpan="4"
                    HorizontalOptions="End" VerticalOptions="End"
                    Opacity="0"
                    Spacing="0">
                    <ffimageloadingsvg:SvgCachedImage
                        WidthRequest="320" HeightRequest="320"
                        Source="resource://SmartSolucionesCuba.Viderhe.Terminal.Player.Assets.Images.viderhe-identity-high-contrast-light.svg"
                        Aspect="AspectFill" />
                    <Image HorizontalOptions="Center">
                        <Image.Source>
                            <OnPlatform x:TypeArguments="ImageSource">
                                <On Platform="Android" Value="powerby_signature.png" />
                                <On Platform="UWP" Value="Assets/PowerbySignature.png" />
                            </OnPlatform>
                        </Image.Source>
                    </Image>
                </StackLayout>
                <!--<StackLayout 
                    x:Name="ProductIdentityContainer"
                    Grid.ColumnSpan="2" Grid.Row="3"
                    Orientation="Horizontal"
                    Spacing="0"
                    Opacity="0">
                    <ffimageloadingsvg:SvgCachedImage
                        HorizontalOptions="Start" VerticalOptions="End"
                        WidthRequest="320" HeightRequest="120"
                        Source="resource://SmartSolucionesCuba.Viderhe.Terminal.Player.Assets.Images.viderhe-identity-high-contrast-light.svg"
                        Aspect="AspectFill" />
                    <Image HorizontalOptions="End" VerticalOptions="End">
                        <Image.Source>
                            <OnPlatform x:TypeArguments="ImageSource">
                                <On Platform="Android" Value="powerby_signature.png" />
                                <On Platform="UWP" Value="Assets/PowerbySignature.png" />
                            </OnPlatform>
                        </Image.Source>
                    </Image>
                </StackLayout>-->
            </Grid>
        </Grid>
    </ContentPage.Content>
</ContentPage>
