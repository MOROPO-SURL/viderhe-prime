<?xml version="1.0" encoding="utf-8" ?>
<ContentPage 
    xmlns="http://xamarin.com/schemas/2014/forms"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:ios="clr-namespace:Xamarin.Forms.PlatformConfiguration.iOSSpecific;assembly=Xamarin.Forms.Core"
    xmlns:renderedviews="clr-namespace:SmartSolucionesCuba.Viderhe.Terminal.Player.Views.Rendered"
    xmlns:commontemplatingpresentationconverters="clr-namespace:SmartSolucionesCuba.Viderhe.Extend.Common.Templating.Presentation.Converters;assembly=SmartSolucionesCuba.Viderhe.Extend.Common.Templating.Presentation"
    xmlns:ffimageloadingsvg="clr-namespace:FFImageLoading.Svg.Forms;assembly=FFImageLoading.Svg.Forms"
    x:Class="SmartSolucionesCuba.Viderhe.Terminal.Player.Pages.MainPage"
    ios:Page.PrefersStatusBarHidden="True">
    <ContentPage.Resources>
        <ResourceDictionary>
            <commontemplatingpresentationconverters:SizeToRelativeValueConverter x:Key="SizeToRelativeValueConverter" />
            <commontemplatingpresentationconverters:ThicknessToRelativeValueConverter x:Key="ThicknessToRelativeValueConverter" />

            <Thickness x:Key="CurrentTaskProgressBarMargin">0,30</Thickness>
            <Thickness x:Key="PageLayoutMargin">80</Thickness>
        </ResourceDictionary>
    </ContentPage.Resources>
    <ContentPage.Content>
        <Grid>
            <Grid.Background>
                <LinearGradientBrush>
                    <GradientStop 
                        Color="#4314c6"
                        Offset="0.1" />
                    <GradientStop 
                        Color="#1b7be8"
                        Offset="1.0" />
                </LinearGradientBrush>
            </Grid.Background>
            <Grid Margin="{Binding Source={StaticResource PageLayoutMargin}, Converter={StaticResource ThicknessToRelativeValueConverter}, Mode=OneTime}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Label
                    x:Name="StepTitleLabel"
                    Grid.Column="0" Grid.Row="0"
                    Opacity="0"
                    Text="{Binding Path=Title}"
                    TextColor="White"
                    FontSize="{Binding Source=48, Converter={StaticResource SizeToRelativeValueConverter}, Mode=OneTime}" />
                <renderedviews:IndeterminableProgressBarView
                    x:Name="CurrentTaskProgressBar"
                    Grid.ColumnSpan="2" Grid.Row="1"
                    Opacity="0"
                    Margin="{Binding Source={StaticResource CurrentTaskProgressBarMargin}, Converter={StaticResource ThicknessToRelativeValueConverter}, Mode=OneTime}"
                    ProgressColor="White"
                    HeightRequest="{Binding Source=20, Converter={StaticResource SizeToRelativeValueConverter}, Mode=OneTime}" />
                <ContentView 
                    x:Name="StepDetailContentView"
                    Content="{Binding Path=DetailContentView}"
                    Grid.ColumnSpan="2" Grid.Row="2" />
                <StackLayout 
                    x:Name="ProductIdentityContainer"
                    Grid.Column="1" Grid.RowSpan="4"
                    HorizontalOptions="End" VerticalOptions="End"
                    Opacity="0"
                    Spacing="0">
                    <ffimageloadingsvg:SvgCachedImage
                        WidthRequest="{Binding Source=180, Converter={StaticResource SizeToRelativeValueConverter}, Mode=OneTime}"
                        Source="resource://SmartSolucionesCuba.Viderhe.Terminal.Player.Assets.Images.viderhe-identity-high-contrast-light.svg" />
                </StackLayout>
                <!--<StackLayout 
                    x:Name="ProductIdentityContainer"
                    Grid.ColumnSpan="2" Grid.Row="3"
                    Orientation="Horizontal"
                    Spacing="0"
                    Opacity="0">
                    <ffimageloadingsvg:SvgCachedImage
                        HorizontalOptions="Start" VerticalOptions="End"
                        WidthRequest="320" HeightRequest="120"
                        Source="resource://SmartSolucionesCuba.Viderhe.Terminal.Player.Assets.Images.viderhe-identity-high-contrast-light.svg"
                        Aspect="AspectFill" />
                    <Image HorizontalOptions="End" VerticalOptions="End">
                        <Image.Source>
                            <OnPlatform x:TypeArguments="ImageSource">
                                <On Platform="Android" Value="powerby_signature.png" />
                                <On Platform="UWP" Value="Assets/PowerbySignature.png" />
                            </OnPlatform>
                        </Image.Source>
                    </Image>
                </StackLayout>-->
            </Grid>
        </Grid>
    </ContentPage.Content>
</ContentPage>
