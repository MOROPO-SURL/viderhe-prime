<?xml version="1.0" encoding="UTF-8"?>
<sscxftoolkitmvvmviews:ContentView 
    xmlns="http://xamarin.com/schemas/2014/forms" 
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:managers="clr-namespace:SmartSolucionesCuba.Viderhe.Terminal.Player.Managers"
    xmlns:sscxftoolkitmvvmviews="clr-namespace:SmartSolucionesCuba.XFToolKit.Mvvm.Views;assembly=SmartSolucionesCuba.XFToolKit.Mvvm"
    x:Class="SmartSolucionesCuba.Viderhe.Terminal.Player.Views.ConfigurationStepPlayerRegistrationDetailView">
    <ContentView.Content>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition />
            </Grid.RowDefinitions>
            <Label
                Grid.ColumnSpan="2" Grid.Row="0"
                Style="{StaticResource ConfigurationStepSubtitleLabelStyle}"
                Text="Reproductor no asociado con su cuenta. Registre mediante Viderhe Control un nuevo reproductor con el identificador siguiente:" />
            <Label 
                Grid.Column="0" Grid.Row="1" Grid.RowSpan="2"
                Text="&#xF237;"
                Style="{StaticResource ConfigurationStepDataIconLabelStyle}" />
            <Label
                Grid.Column="1" Grid.Row="1"
                Text="Identificador del Reproductor"
                Style="{StaticResource ConfigurationStepDataCaptionLabelStyle}" />
            <Label 
                Grid.Column="1" Grid.Row="2"
                Text="{Binding Source={x:Static managers:ConfigurationManager.Instance}, Path=PlayerId}" 
                Style="{StaticResource ConfigurationStepDataValueLabelStyle}"/>
        </Grid>
    </ContentView.Content>
</sscxftoolkitmvvmviews:ContentView>