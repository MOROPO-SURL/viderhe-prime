<?xml version="1.0" encoding="utf-8" ?>
<sscxftoolkitmvvmpages:BindingContextedContentPage 
    xmlns="http://xamarin.com/schemas/2014/forms"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:pagemodels="clr-namespace:SmartSolucionesCuba.Viderhe.Extend.OHCC.RailwayMuseum.Templating.Dashboard.Presentation.Models.Page"
    xmlns:supportpresentationdashboardviews="clr-namespace:SmartSolucionesCuba.Viderhe.Support.Presentation.Dashboard.Views;assembly=SmartSolucionesCuba.Viderhe.Support.Presentation.Dashboard"
    xmlns:sscxftoolkitmvvmpages="clr-namespace:SmartSolucionesCuba.XFToolKit.Mvvm.Pages;assembly=SmartSolucionesCuba.XFToolKit.Mvvm"
    xmlns:sscxftoolkitpresentationconverters="clr-namespace:SmartSolucionesCuba.XFToolKit.Presentation.Converters;assembly=SmartSolucionesCuba.XFToolKit.Presentation"
    xmlns:ffimageloadingforms="clr-namespace:FFImageLoading.Forms;assembly=FFImageLoading.Forms"
    x:Class="SmartSolucionesCuba.Viderhe.Extend.OHCC.RailwayMuseum.Templating.Dashboard.Presentation.Pages.CornerTileVideoPresentingVideoPlacardConfigurationPage"
    x:TypeArguments="pagemodels:CornerTileVideoPresentingVideoPlacardConfigurationPageModel">
    <ContentPage.Resources>
        <ResourceDictionary>
            <sscxftoolkitpresentationconverters:FractionConverter x:Key="FractionConverter" />
            <sscxftoolkitpresentationconverters:NotNullOrEmptyStringToBooleanConverter x:Key="NotNullOrEmptyStringToBooleanConverter" />
            <sscxftoolkitpresentationconverters:NotNullToBooleanConverter x:Key="NotNullToBooleanConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>
    <ContentPage.ToolbarItems>
        <ToolbarItem 
            Text="Aplicar"
            Clicked="ApplyToolbarItem_Clicked">
            <ToolbarItem.IconImageSource>
                <FontImageSource FontFamily="{StaticResource ToolbarIconFontFamily}" Glyph="&#xf12c;">
                    <FontImageSource.Color>
                        <OnPlatform x:TypeArguments="Color">
                            <On Platform="UWP" Value="Black" />
                        </OnPlatform>
                    </FontImageSource.Color>
                </FontImageSource>
            </ToolbarItem.IconImageSource>
        </ToolbarItem>
        <ToolbarItem 
            Text="Cancelar"
            Clicked="CancelToolbarItem_Clicked">
            <ToolbarItem.IconImageSource>
                <FontImageSource FontFamily="{StaticResource ToolbarIconFontFamily}" Glyph="&#xf156;">
                    <FontImageSource.Color>
                        <OnPlatform x:TypeArguments="Color">
                            <On Platform="UWP" Value="Black" />
                        </OnPlatform>
                    </FontImageSource.Color>
                </FontImageSource>
            </ToolbarItem.IconImageSource>
        </ToolbarItem>
    </ContentPage.ToolbarItems>
    <ContentPage.Content>
        <Grid>
            <supportpresentationdashboardviews:BackgroundView />
            <ScrollView>
                <Grid 
                    Margin="10"
                    ColumnSpacing="10" RowSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Frame 
                        Grid.ColumnSpan="3" Grid.Row="0"
                        Style="{StaticResource FormFieldFrame}">
                        <StackLayout>
                            <Label Text="Etiqueta" Style="{StaticResource FormLabel}" />
                            <Entry Text="{Binding Path=Label}" />
                        </StackLayout>
                    </Frame>
                    <Frame 
                        Grid.Column="0" Grid.Row="1"
                        Style="{StaticResource FormFieldFrame}">
                        <StackLayout>
                            <Label Text="A Pantalla Completa" Style="{StaticResource FormLabel}" />
                            <Switch IsToggled="{Binding Path=RequireUnobstructedPresetation}" />
                        </StackLayout>
                    </Frame>
                    <Frame 
                        Grid.Column="0" Grid.Row="2"
                        Style="{StaticResource FormFieldFrame}"
                        Padding="0"
                        VerticalOptions="Start">
                        <Grid RowSpacing="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition />
                            </Grid.RowDefinitions>
                            <Label 
                                Grid.Column="0" Grid.Row="0"
                                Style="{StaticResource FormLabel}"
                                Margin="10,10,10,6"
                                Text="Video del Mosaico Presentador" />
                            <Button
                                Grid.Column="1" Grid.Row="0"
                                VerticalOptions="Start"
                                Text="Seleccionar"
                                Clicked="PickPresenterTileVideoButton_Clicked"  />
                            <ffimageloadingforms:CachedImage
                                Margin="0"
                                Grid.ColumnSpan="2" Grid.Row="1"
                                BackgroundColor="Black"
                                Source="{Binding Path=PresenterTileVideo, Converter={StaticResource VideoViewModelToThumbnailImageSourceConverter}}"
                                Aspect="AspectFill"
                                HeightRequest="{Binding Source={x:RelativeSource Mode=Self}, Path=Width}"
                                CacheType="Disk"
                                CacheDuration="8760:00:00" />
                            <Grid 
                                Grid.ColumnSpan="2" Grid.Row="1"
                                IsVisible="{Binding Path=PresenterTileVideo, Converter={StaticResource NotNullToBooleanConverter}}"
                                BackgroundColor="#99000000">
                                <Label 
                                    IsVisible="{Binding Path=PresenterTileVideo.About, Converter={StaticResource NotNullOrEmptyStringToBooleanConverter}}"
                                    VerticalOptions="End" 
                                    Padding="8"
                                    BackgroundColor="#99000000"
                                    Text="{Binding Path=PresenterTileVideo.About}"
                                    TextColor="White"
                                    LineBreakMode="TailTruncation" />
                                <ImageButton 
                                    HorizontalOptions="Center" VerticalOptions="Center"
                                    WidthRequest="120"
                                    Clicked="PresenterTileVideoPlayButton_Clicked">
                                    <ImageButton.Source>
                                        <FontImageSource 
                                            Color="White"
                                            FontFamily="{StaticResource IconFontFamily}"
                                            Glyph="&#xf40c;" />
                                    </ImageButton.Source>
                                </ImageButton>
                            </Grid>
                        </Grid>
                    </Frame>
                    <Frame 
                        Grid.Column="0" Grid.Row="3"
                        Style="{StaticResource FormFieldFrame}"
                        VerticalOptions="Start">
                        <StackLayout>
                            <Label Text="Posición del Mosaico Presentador" Style="{StaticResource FormLabel}" />
                            <Picker ItemsSource="{Binding Path=AvailablePresenterTileVideoScreenCorners}" SelectedItem="{Binding Path=PresenterTileVideoScreenCorner}" />
                        </StackLayout>
                    </Frame>
                    <Frame 
                        Grid.Column="1" Grid.ColumnSpan="2" Grid.Row="2"
                        Style="{StaticResource FormFieldFrame}"
                        Padding="0">
                        <Grid RowSpacing="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition />
                            </Grid.RowDefinitions>
                            <Label 
                                Grid.Column="0" Grid.Row="0"
                                Style="{StaticResource FormLabel}"
                                Margin="10,10,10,6"
                                Text="Video Presentado" />
                            <Button
                                Grid.Column="1" Grid.Row="0"
                                VerticalOptions="Start"
                                Text="Seleccionar"
                                Clicked="PickPresentedVideoButton_Clicked"  />
                            <ffimageloadingforms:CachedImage
                                Margin="0"
                                Grid.ColumnSpan="2" Grid.Row="1"
                                BackgroundColor="Black"
                                Source="{Binding Path=PresentedVideo, Converter={StaticResource VideoViewModelToThumbnailImageSourceConverter}}"
                                HeightRequest="{Binding Source={x:RelativeSource Mode=Self}, Path=Width, Converter={StaticResource FractionConverter}, ConverterParameter=1.777777777777778}"
                                CacheType="Disk"
                                CacheDuration="8760:00:00" />
                            <Grid 
                                Grid.ColumnSpan="2" Grid.Row="1"
                                IsVisible="{Binding Path=PresentedVideo, Converter={StaticResource NotNullToBooleanConverter}}"
                                BackgroundColor="#99000000">
                                <Label 
                                    IsVisible="{Binding Path=PresentedVideo.About, Converter={StaticResource NotNullOrEmptyStringToBooleanConverter}}"
                                    VerticalOptions="End" 
                                    Padding="8"
                                    BackgroundColor="#99000000"
                                    Text="{Binding Path=PresentedVideo.About}"
                                    TextColor="White"
                                    LineBreakMode="TailTruncation" />
                                <ImageButton 
                                    HorizontalOptions="Center" VerticalOptions="Center"
                                    WidthRequest="120"
                                    Clicked="PresentedVideoPlayButton_Clicked">
                                    <ImageButton.Source>
                                        <FontImageSource 
                                            Color="White"
                                            FontFamily="{StaticResource IconFontFamily}"
                                            Glyph="&#xf40c;" />
                                    </ImageButton.Source>
                                </ImageButton>
                            </Grid>
                        </Grid>
                    </Frame>
                    <Frame 
                        Grid.Column="1" Grid.Row="3"
                        Style="{StaticResource FormFieldFrame}">
                        <StackLayout>
                            <Label Text="Matener centrado Video Presentado?" Style="{StaticResource FormLabel}" />
                            <Switch IsToggled="{Binding Path=PresentedVideoCenteredAtPresentation}" />
                        </StackLayout>
                    </Frame>
                </Grid>
            </ScrollView>
            <supportpresentationdashboardviews:BusyView />
        </Grid>
    </ContentPage.Content>
</sscxftoolkitmvvmpages:BindingContextedContentPage>