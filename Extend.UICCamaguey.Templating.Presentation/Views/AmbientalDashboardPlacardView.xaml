<?xml version="1.0" encoding="UTF-8"?>
<extendcommontemplatingpresentationviews:BaseTemplatedPlacardPresentationView 
    xmlns="http://xamarin.com/schemas/2014/forms" 
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:converters="clr-namespace:SmartSolucionesCuba.Viderhe.Extend.UICCamaguey.Templating.Presentation.Converters"
    xmlns:extendcommontemplatingpresentationconverters="clr-namespace:SmartSolucionesCuba.Viderhe.Extend.Common.Templating.Presentation.Converters;assembly=SmartSolucionesCuba.Viderhe.Extend.Common.Templating.Presentation"
    xmlns:extendcommontemplatingpresentationviews="clr-namespace:SmartSolucionesCuba.Viderhe.Extend.Common.Templating.Presentation.Views;assembly=SmartSolucionesCuba.Viderhe.Extend.Common.Templating.Presentation"
    xmlns:microcharts="clr-namespace:Microcharts.Forms;assembly=Microcharts.Forms"
    x:Class="SmartSolucionesCuba.Viderhe.Extend.UICCamaguey.Templating.Presentation.Views.AmbientalDashboardPlacardView"
    x:Name="RootView">
    <ContentView.Resources>
        <ResourceDictionary>
            <converters:AmbientalReadingDisplayModelToLastValuePresentationConverter x:Key="AmbientalReadingDisplayModelToLastValuePresentationConverter" PlacardView="{Reference RootView}" />
            
            <extendcommontemplatingpresentationconverters:SizeToRelativeValueConverter x:Key="SizeToRelativeValueConverter" SizeScalableView="{Reference RootView}" />
        </ResourceDictionary>
    </ContentView.Resources>
    <ContentView.Content>
        <Grid x:Name="Wrapper" BackgroundColor="White">
            <Grid 
                x:Name="PlacardLayout"
                ColumnSpacing="0" RowSpacing="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition />
                    <RowDefinition />
                </Grid.RowDefinitions>
                <Label
                    Grid.Column="1" Grid.Row="0"
                    HorizontalOptions="Center" VerticalOptions="Center"
                    Text="{Binding Path=LastReading, Converter={StaticResource AmbientalReadingDisplayModelToLastValuePresentationConverter}}"
                    FontAttributes="Bold"
                    FontSize="{Binding Source=144, Converter={StaticResource SizeToRelativeValueConverter}}" />
                <microcharts:ChartView
                    Grid.ColumnSpan="2" Grid.Row="1"
                    Chart="{Binding Path=Chart}"/>
            </Grid>
        </Grid>
    </ContentView.Content>
</extendcommontemplatingpresentationviews:BaseTemplatedPlacardPresentationView>