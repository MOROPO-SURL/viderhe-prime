@model SmartSolucionesCuba.Viderhe.Cloud.Models.View.UserProfileViewModel

@{
    ViewData["Heading"] = "Modificar Perfil de Usuario";

    ViewData["Title"] = ViewData["Heading"];

    ViewData[BreadcrumbViewModel.BREADCRUMBS_MAP_KEY] = new List<BreadcrumbViewModel>
    {
        new BreadcrumbViewModel
        {
            Caption = "<span class=\"mdi mdi-cogs\"></span> Inicio",
            Url = "/"
        },
        new BreadcrumbViewModel
        {
            Caption = "Perfil de Usuario",
            Url = Url.Action("index", "account", new { Area = "security" })
        },
        new BreadcrumbViewModel
        {
            Caption = ViewData["Heading"].ToString()
        }
    };

    Layout = "_UserAuthenticatedLayout";
}

<h3>Modificar Perfil de Usuario</h3>
<hr class="mb-4" />

<form asp-action="edit">
    <div class="row">            
        <div class="col-md-6 mb-3">
            <label class="control-label">@GlobalViewLocalizationHelper.Localize("Login")</label>
            <input type="text" readonly="readonly" value="@User.Identity.Name" class="form-control" />
        </div>
    </div>
    <hr />
    <button type="submit" class="btn btn-primary">Modificar</button>
    <a class="btn btn-light" asp-action="index">Cancelar</a>
</form>