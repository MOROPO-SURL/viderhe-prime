@using MOROPO.SAPRESSC.Core.Common.Models.View;

@model MOROPO.SAPRESSC.Middleware.Security.Essential.Web.Backend.Models.View.UserInputViewModel

@{
    ViewData["Title"] = "Modificar Usuario";

    ViewData[BreadcrumbViewModel.BREADCRUMBS_MAP_KEY] = new List<BreadcrumbViewModel>
    {
        new BreadcrumbViewModel
        {
            Caption = "<span class=\"mdi mdi-cogs\" style=\"margin-right: 4px;\"></span>" + GlobalViewLocalizationHelper.Localize("Dashboard", ViewLocalizer),
            Url = Url.Action("index", "dashboard", new { Area = string.Empty })
        },
        new BreadcrumbViewModel
        {
            Caption = "Administración de Usuarios",
            Url = Url.Action("index")
        },
        new BreadcrumbViewModel
        {
            Caption = ViewData["Title"].ToString()
        }
    };

    Layout = "_BackendLayout";
}

@using (Html.BeginForm("edit", "users", new { Area = "security", key = string.Empty }, FormMethod.Post, true, new { enctype = "multipart/form-data" }))
{
    @Html.ValidationSummary(true)

    @Html.HiddenFor(model => model.Id)

    <div class="card" style="margin-bottom: 20px;">
        <div class="card-header"><h4 class="mb-0">@ViewData["Title"]</h4></div>

        <div class="card-body">
            <div class="mb-3">
                @Html.LabelFor(model => model.Id, new { @class = "control-label" })
                <div>@Model.Id</div>
            </div>

            <div class="row">
                <div class="col-sm-4 mb-3">
                    <div class="checkbox">
                        <label>
                            @Html.EditorFor(model => model.Enabled) Habilitado
                        </label>
                        @Html.ValidationMessageFor(model => model.Enabled, null, new { @class = "text-danger", style = "display: inline-block;" })
                    </div>
                </div>

                <div class="col-sm-4 mb-3">
                    <div class="checkbox">
                        <label>
                            @Html.EditorFor(model => model.PasswordChangeRequired) Debe cambiar la contraseña?
                        </label>
                        @Html.ValidationMessageFor(model => model.PasswordChangeRequired, null, new { @class = "text-danger", style = "display: inline-block;" })
                    </div>
                </div>

                <div class="col-sm-4 mb-3">
                    <div class="checkbox">
                        <label>
                            @Html.EditorFor(model => model.HasFullAccess) Es super usuario?
                        </label>
                        @Html.ValidationMessageFor(model => model.HasFullAccess, null, new { @class = "text-danger", style = "display: inline-block;" })
                    </div>
                </div>
            </div>

            <fieldset>
                <legend class="border-bottom h4">Roles</legend>
                @if (Model.SelectableRoles != null && Model.SelectableRoles.Count > 0)
                {
                    <div class="row">
                    @for (int i = 0; i < Model.SelectableRoles.Count; i++)
                    {
                        <div class="col-md-6">
                            @Html.EditorFor(subModel => subModel.SelectableRoles[i], "SelectionDescriptedGuidIDItemInputViewModel")
                        </div>
                    }
                    </div>
                }
                else
                {
                    <div>Sin elementos que mostrar.</div>
                }
            </fieldset>
        </div>
        <div class="card-footer">
            <button type="submit" class="btn btn-primary">Modificar</button>
            <a class="btn btn-light" href="@Url.Action("index")">Regresar al listado</a>
        </div>
    </div>
}