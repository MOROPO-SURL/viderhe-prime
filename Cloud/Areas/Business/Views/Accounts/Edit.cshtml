@model SmartSolucionesCuba.Viderhe.Cloud.Models.View.AccountInputViewModel

@{
    ViewData["Title"] = "Modificar Cuenta (Datos)";

    ViewData[BreadcrumbViewModel.BREADCRUMBS_MAP_KEY] = new List<BreadcrumbViewModel>
    {
        new BreadcrumbViewModel
        {
            Caption = "<span class=\"mdi mdi-cogs\" style=\"margin-right: 4px;\"></span>" + GlobalViewLocalizationHelper.Localize("Dashboard", ViewLocalizer),
            Url = "/"
        },
        new BreadcrumbViewModel
        {
            Caption = "Administración de Cuentas",
            Url = Url.Action("index")
        },
        new BreadcrumbViewModel
        {
            Caption = ViewData["Title"].ToString()
        }
    };

    Layout = "_BackendLayout";
}

@section styles {
    <link rel="stylesheet" type="text/css" href="~/lib/bootstrap-colorpicker/dist/css/bootstrap-colorpicker.min.css" />

    <style type="text/css">
        input[type=file] {
            width: 0;
            height: 0;
            overflow: hidden;
        }
    </style>
}

@section scripts {
    <script type="text/javascript" src="~/lib/bootstrap-colorpicker/dist/js/bootstrap-colorpicker.min.js"></script>

    <script type="text/javascript">
        $(function () {
            $('.colorpicker-element').colorpicker();

            $(document).on("change", "#LogoImageFile", function () {
                var files = !!this.files ? this.files : [];

                if (!files.length || !window.FileReader) return; // no file selected, or no FileReader support

                if (/^image/.test(files[0].type)) {
                    var reader = new FileReader();

                    reader.readAsDataURL(files[0]);

                    reader.onloadend = function () {
                        $('#LogoImageFilePreview').attr('src', this.result);
                    }
                }
            });

            $(document).on("change", "#HorizontalSplashImageFile", function () {
                var files = !!this.files ? this.files : [];

                if (!files.length || !window.FileReader) return; // no file selected, or no FileReader support

                if (/^image/.test(files[0].type)) {
                    var reader = new FileReader();

                    reader.readAsDataURL(files[0]);

                    reader.onloadend = function () {
                        $('#HorizontalSplashImageFilePreview').attr('src', this.result);
                    }
                }
            });

            $(document).on("change", "#VerticalSplashImageFile", function () {
                var files = !!this.files ? this.files : [];

                if (!files.length || !window.FileReader) return; // no file selected, or no FileReader support

                if (/^image/.test(files[0].type)) {
                    var reader = new FileReader();

                    reader.readAsDataURL(files[0]);

                    reader.onloadend = function () {
                        $('#VerticalSplashImageFilePreview').attr('src', this.result);
                    }
                }
            });
        });
    </script>
}

@using (Html.BeginForm("edit", "accounts", new { Area = "business", key = string.Empty }, FormMethod.Post, true, new { enctype = "multipart/form-data" }))
{
    @Html.ValidationSummary(true)

    @Html.HiddenFor(model => model.Id)

    <div class="card mb-3">
        <div class="card-header">
            <h4>Modificar Cuenta</h4>
            <ul class="nav nav-tabs card-header-tabs">
                <li class="nav-item">
                    <a class="nav-link active" href="#">Datos</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" asp-action="moderators" asp-route-key="@Model.Id">Moderadores</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" asp-action="extensions" asp-route-key="@Model.Id">Complementos</a>
                </li>
            </ul>
        </div>

        <div class="card-body">
            <div class="row">
                <div class="col-md-9 mb-3">
                    @Html.LabelFor(model => model.Name, new { @class = "control-label" })
                    @Html.TextBoxFor(model => model.Name, new { @class = "form-control" })
                    @Html.ValidationMessageFor(model => model.Name, null, new { @class = "text-danger" })
                </div>
                <div class="col-md-3 mb-3">
                    <div class="checkbox">
                        <label>
                            @Html.EditorFor(model => model.Enabled) Habilitada
                        </label>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-md-3 col-sm-6 mb-3">
                    @Html.HiddenFor(model => model.LogoImageId)
                    <div>
                        @Html.LabelFor(model => model.LogoImageFile, new { @class = "control-label h5 mt-2" })
                        <label class="btn btn-sm btn-light float-right">
                            <span class="mdi mdi-18px mdi-image-search"></span>
                            @Html.EditorFor(model => model.LogoImageFile)
                        </label>
                    </div>
                    <hr class="clearfix" />
                    <div><img src="@Url.Action("image", "default", new { Area = "media", key = Model.LogoImageId })" class="img-thumbnail" id="LogoImageFilePreview" style="margin-bottom: 10px;" /></div>
                    <div>@Html.ValidationMessageFor(model => model.LogoImageFile, null, new { @class = "text-danger" })</div>
                </div>
                <div class="col-md-3 col-sm-6 mb-3">
                    @Html.LabelFor(model => model.MaxPlayerCount, new { @class = "control-label" })
                    @Html.TextBoxFor(model => model.MaxPlayerCount, new { @class = "form-control" })
                    @Html.ValidationMessageFor(model => model.MaxPlayerCount, null, new { @class = "text-danger" })
                </div>
                <div class="col-md-3 col-sm-6 mb-3">
                    @Html.LabelFor(model => model.PrimaryColor, new { @class = "control-label" })
                    <div class="input-group colorpicker-element">
                        @Html.TextBoxFor(model => model.PrimaryColor, new { @class = "form-control", @readonly = "readonly" })
                        <span class="input-group-append">
                            <span class="input-group-text colorpicker-input-addon"><i></i></span>
                        </span>
                    </div>
                    @Html.ValidationMessageFor(model => model.PrimaryColor, null, new { @class = "text-danger" })
                </div>
                <div class="col-md-3 col-sm-6 mb-3">
                    @Html.LabelFor(model => model.SecoundaryColor, new { @class = "control-label" })
                    <div class="input-group colorpicker-element">
                        @Html.TextBoxFor(model => model.SecoundaryColor, new { @class = "form-control", @readonly = "readonly" })
                        <span class="input-group-append">
                            <span class="input-group-text colorpicker-input-addon"><i></i></span>
                        </span>
                    </div>
                    @Html.ValidationMessageFor(model => model.SecoundaryColor, null, new { @class = "text-danger" })
                </div>
            </div>
            <div class="row">
                <div class="col-md-4 col-sm-4 mb-3">
                    @Html.HiddenFor(model => model.VerticalSplashImageId)
                    <div>
                        @Html.LabelFor(model => model.VerticalSplashImageFile, new { @class = "control-label h5 mt-2" })
                        <label class="btn btn-sm btn-light float-right">
                            <span class="mdi mdi-18px mdi-image-search"></span>
                            @Html.EditorFor(model => model.VerticalSplashImageFile)
                        </label>
                    </div>
                    <hr class="clearfix" />
                    <div><img src="@Url.Action("image", "default", new { Area = "media", key = Model.VerticalSplashImageId })" class="img-thumbnail" id="VerticalSplashImageFilePreview" style="margin-bottom: 10px;" /></div>
                    <div>@Html.ValidationMessageFor(model => model.VerticalSplashImageFile, null, new { @class = "text-danger" })</div>
                </div>
                <div class="col-md-8 col-sm-8">
                    @Html.HiddenFor(model => model.HorizontalSplashImageId)
                    <div>
                        @Html.LabelFor(model => model.HorizontalSplashImageFile, new { @class = "control-label h5 mt-2" })
                        <label class="btn btn-sm btn-light float-right">
                            <span class="mdi mdi-18px mdi-image-search"></span>
                            @Html.EditorFor(model => model.HorizontalSplashImageFile)
                        </label>
                    </div>
                    <hr class="clearfix" />
                    <div><img src="@Url.Action("image", "default", new { Area = "media", key = Model.HorizontalSplashImageId })" class="img-thumbnail" id="HorizontalSplashImageFilePreview" style="margin-bottom: 10px;" /></div>
                    <div>@Html.ValidationMessageFor(model => model.HorizontalSplashImageFile, null, new { @class = "text-danger" })</div>
                </div>
            </div>
        </div>
        <div class="card-footer">
            <button type="submit" class="btn btn-primary">Modificar</button>
            <a class="btn btn-light" href="@Url.Action("index")">Regresar al listado</a>
        </div>
    </div>
}