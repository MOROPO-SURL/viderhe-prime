@using MOROPO.SAPRESSC.Middleware.Identity.Persistence.Enumerations;

@model SmartSolucionesCuba.Viderhe.Cloud.Models.View.ModeratorInputViewModel

@{
    ViewData["Title"] = "Agregar Moderador";

    ViewData[BreadcrumbViewModel.BREADCRUMBS_MAP_KEY] = new List<BreadcrumbViewModel>
    {
        new BreadcrumbViewModel
        {
            Caption = "<span class=\"mdi mdi-cogs\" style=\"margin-right: 4px;\"></span>" + GlobalViewLocalizationHelper.Localize("Dashboard", ViewLocalizer),
            Url = "/"
        },
        new BreadcrumbViewModel
        {
            Caption = "Administración de Cuentas",
            Url = Url.Action("index")
        },
        new BreadcrumbViewModel
        {
            Caption = "Modificar Cuenta (Moderadores)",
            Url = Url.Action("moderators", new { key = Model.Account.Id }),
        },
        new BreadcrumbViewModel
        {
            Caption = ViewData["Title"].ToString()
        }
    };

    Layout = "_BackendLayout";
}

@section styles {
    <link rel="stylesheet" href="~/lib/gijgo/modular/css/core.min.css" type="text/css" />
    <link rel="stylesheet" href="~/lib/gijgo/modular/css/datepicker.min.css" type="text/css" />

    <style type="text/css">
        #ImageFile {
            width: 0;
            height: 0;
            overflow: hidden;
        }
    </style>
}

@section scripts {
    <script src="~/lib/gijgo/modular/js/core.min.js" type="text/javascript"></script>
    <script src="~/lib/gijgo/modular/js/datepicker.min.js" type="text/javascript"></script>

    <script type="text/javascript">
        $('#BornDate').datepicker({
            uiLibrary: 'bootstrap4',
            modal: true,
            header: true,
            footer: true,
            locale: 'es-es',
            format: 'dd/mm/yyyy',
            value: '@Model.BornDate?.ToShortDateString()'
        });

        $(function () {
            $(document).on("change", "#ImageFile", function () {
                var files = !!this.files ? this.files : [];

                if (!files.length || !window.FileReader) return; // no file selected, or no FileReader support

                if (/^image/.test(files[0].type)) {
                    var reader = new FileReader();

                    reader.readAsDataURL(files[0]);

                    reader.onloadend = function () {
                        $('#ImageFilePreview').attr('src', this.result);
                    }
                }

            });
        });
    </script>
}

@using (Html.BeginForm("addmoderator", "accounts", new { Area = "business", key = Model.Account.Id }, FormMethod.Post, true, new { enctype = "multipart/form-data" }))
{
    @Html.ValidationSummary(true)

    <div class="card mb-3">
        <div class="card-header"><h4 class="mb-0">@ViewData["Title"]</h4></div>

        <div class="card-body">
            <div class="row">
                <div class="col-lg-3 col-md-4 col-sm-4 mb-3">
                    <div class="card">
                        <img src="~/img/default-person-picture.jpg" class="card-img-top" id="ImageFilePreview" />
                        <label class="btn btn-light" style="border-top-left-radius: 0; border-top-right-radius: 0; margin-bottom: 0;">
                            @GlobalViewLocalizationHelper.Localize("Upload", ViewLocalizer) ...
                            @Html.EditorFor(model => model.ImageFile)
                        </label>
                    </div>
                    @Html.ValidationMessageFor(model => model.ImageFile, null, new { @class = "text-danger" })
                </div>
                <div class="col-lg-9 col-md-8 col-sm-8 mb-3">
                    <div class="row">            
                        <div class="col-md-6 mb-3">
                            @Html.LabelFor(model => model.UserId, new { @class = "control-label" })
                            @Html.DropDownListFor(model => model.UserId, Model.SelectableUsers, new { @class = "form-control" })
                            @Html.ValidationMessageFor(model => model.UserId, null, new { @class = "text-danger" })
                        </div>
                    </div>
                    <div class="row">            
                        <div class="col-md-6 mb-3">
                            @Html.LabelFor(model => model.Name, new { @class = "control-label" })
                            @Html.TextBoxFor(model => model.Name, new { @class = "form-control" })
                            @Html.ValidationMessageFor(model => model.Name, null, new { @class = "text-danger" })
                        </div>
                        <div class="col-md-6 mb-3">
                            @Html.LabelFor(model => model.LastName, new { @class = "control-label" })
                            @Html.TextBoxFor(model => model.LastName, new { @class = "form-control" })
                            @Html.ValidationMessageFor(model => model.LastName, null, new { @class = "text-danger" })
                        </div>
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    @Html.LabelFor(model => model.BornDate, new { @class = "control-label" })
                    @Html.TextBoxFor(model => model.BornDate, new { @class = "form-control", @readonly = "readonly" })
                    @Html.ValidationMessageFor(model => model.BornDate, null, new { @class = "text-danger" })
                </div>
                <div class="col-md-6 mb-3">
                    @Html.LabelFor(model => model.Alias, new { @class = "control-label" })
                    @Html.TextBoxFor(model => model.Alias, new { @class = "form-control" })
                    @Html.ValidationMessageFor(model => model.Alias, null, new { @class = "text-danger" })
                </div>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    @Html.LabelFor(model => model.Sex, new { @class = "control-label" })
                    @Html.DropDownListFor(model => model.Sex, new SelectListItem[] { new SelectListItem(GlobalViewLocalizationHelper.Localize("Unknown", ViewLocalizer), Sex.Unknown.ToString()), new SelectListItem(GlobalViewLocalizationHelper.Localize("Male", ViewLocalizer), Sex.Male.ToString()), new SelectListItem(GlobalViewLocalizationHelper.Localize("Famale", ViewLocalizer), Sex.Famale.ToString()) }, new { @class = "form-control" })
                    @Html.ValidationMessageFor(model => model.Sex, null, new { @class = "text-danger" })
                </div>
                <div class="col-md-6 mb-3">
                    @Html.LabelFor(model => model.CivilStatus, new { @class = "control-label" })
                    @Html.DropDownListFor(model => model.CivilStatus, new SelectListItem[] { new SelectListItem(GlobalViewLocalizationHelper.Localize("Unknow", ViewLocalizer), CivilStatus.Unknow.ToString()), new SelectListItem(GlobalViewLocalizationHelper.Localize("Single", ViewLocalizer), CivilStatus.Single.ToString()), new SelectListItem(GlobalViewLocalizationHelper.Localize("Married", ViewLocalizer), CivilStatus.Married.ToString()), new SelectListItem(GlobalViewLocalizationHelper.Localize("Divorced", ViewLocalizer), CivilStatus.Divorced.ToString()), new SelectListItem(GlobalViewLocalizationHelper.Localize("Widower", ViewLocalizer), CivilStatus.Widower.ToString()) }, new { @class = "form-control" })
                    @Html.ValidationMessageFor(model => model.CivilStatus, null, new { @class = "text-danger" })
                </div>
            </div>
            <div>
                @Html.LabelFor(model => model.About, new { @class = "control-label" })
                @Html.TextAreaFor(model => model.About, 4, 0, new { @class = "form-control" })
                @Html.ValidationMessageFor(model => model.About, null, new { @class = "text-danger" })
            </div>
        </div>
        <div class="card-footer">
            <button type="submit" class="btn btn-primary">Crear</button>
            <a class="btn btn-light" href="@Url.Action("moderators", new { key = Model.Account.Id })">Cancelar</a>
        </div>
    </div>
}