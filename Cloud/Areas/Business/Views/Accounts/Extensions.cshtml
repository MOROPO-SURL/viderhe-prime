@model SmartSolucionesCuba.Viderhe.Cloud.Models.View.AccountExtensionsInputViewModel

@{
    ViewData["Title"] = "Modificar Cuenta (Extensiones)";

    ViewData[BreadcrumbViewModel.BREADCRUMBS_MAP_KEY] = new List<BreadcrumbViewModel>
    {
        new BreadcrumbViewModel
        {
            Caption = "<span class=\"glyphicon glyphicon-home\"></span> Inicio",
            Url = "/"
        },
        new BreadcrumbViewModel
        {
            Caption = "Administración",
            Url = Url.Action("index", "dashboard", new { Area = string.Empty })
        },
        new BreadcrumbViewModel
        {
            Caption = "Cuentas",
            Url = Url.Action("index", "accounts", new { key = "business" })
        },
        new BreadcrumbViewModel
        {
            Caption = ViewData["Title"].ToString()
        }
    };

    Layout = "_BackendLayout";
}

@using (Html.BeginForm("extensions", "accounts", new { Area = "business", key = string.Empty }, FormMethod.Post, true, null))
{
    @Html.ValidationSummary(true)

    @Html.HiddenFor(model => model.AccountId)

    <div class="card mb-3">
        <div class="card-header">
            <h4>Modificar Cuenta</h4>
            <ul class="nav nav-tabs card-header-tabs">
                <li class="nav-item">
                    <a class="nav-link" asp-action="edit" asp-route-key="@Model.Account.Id">Datos</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" asp-action="moderators" asp-route-key="@Model.Account.Id">Moderadores</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link active" href="#">Complementos</a>
                </li>
            </ul>
        </div>
        <div class="card-body">
            <div class="card mb-3">
                <div class="row no-gutters">
                    <div class="col-auto">
                        <img height="200" src="@Url.Action("image", "default", new { Area = "media", key = Model.Account.Logo.Id })" />
                    </div>
                    <div class="col">
                        <div class="card-block p-3">
                            <h4>Cuenta</h4>
                            <hr />
                            <div class="row">
                                <dl class="col-md-6">
                                    <dt>Nombre</dt>
                                    <dd>@Html.DisplayFor(model => model.Account.Name)</dd>
                                </dl>
                                <dl class="col-md-6">
                                    <dt># Max. Reproductores</dt>
                                    <dd>@Html.DisplayFor(model => model.Account.MaxPlayerCount)</dd>
                                </dl>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <fieldset>
                <legend class="mb-3 border-bottom">Complementos</legend>
                <div class="row">
                    @if (Model.SelectableExtensions.Count() > 0)
                    {
                        for (int i = 0; i < Model.SelectableExtensions.Count(); i++)
                        {
                            <div class="col-md-6">
                                @Html.EditorFor(model => model.SelectableExtensions[i], "SelectionDescriptedGuidIDItemInputViewModel")
                            </div>
                        }
                    }
                    else
                    {
                        <div class="col-md-12"><h5>Sin elementos que mostrar.</h5></div>
                    }
                </div>
            </fieldset>
        </div>
        <div class="card-footer">
            <button type="submit" class="btn btn-primary">Modificar</button>
            <a class="btn btn-light" href="@Url.Action("index")">Regresar al listado</a>
        </div>
    </div>
}





