<?xml version="1.0" encoding="utf-8" ?>
<sscxftoolkitmvvmpages:BindingContextedContentPage 
    xmlns="http://xamarin.com/schemas/2014/forms"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:pagemodels="clr-namespace:SmartSolucionesCuba.Viderhe.Extend.Essential.Templating.Dashboard.Presentation.Models.Page"
    xmlns:converters="clr-namespace:SmartSolucionesCuba.Viderhe.Extend.Essential.Templating.Dashboard.Presentation.Converters"
    xmlns:presentationconverters="clr-namespace:SmartSolucionesCuba.Viderhe.Extend.Essential.Templating.Presentation.Converters;assembly=SmartSolucionesCuba.Viderhe.Extend.Essential.Templating.Presentation"
    xmlns:commonconverters="clr-namespace:SmartSolucionesCuba.Viderhe.Extend.Common.Templating.Dashboard.Presentation.Converters;assembly=SmartSolucionesCuba.Viderhe.Extend.Common.Templating.Dashboard.Presentation"
    xmlns:supportpresentationdashboardvalidators="clr-namespace:SmartSolucionesCuba.Viderhe.Support.Presentation.Dashboard.Validators;assembly=SmartSolucionesCuba.Viderhe.Support.Presentation.Dashboard"
    xmlns:supportpresentationdashboardbehaviors="clr-namespace:SmartSolucionesCuba.Viderhe.Support.Presentation.Dashboard.Behaviors;assembly=SmartSolucionesCuba.Viderhe.Support.Presentation.Dashboard"
    xmlns:supportpresentationdashboardpresenters="clr-namespace:SmartSolucionesCuba.Viderhe.Support.Presentation.Dashboard.Presenters;assembly=SmartSolucionesCuba.Viderhe.Support.Presentation.Dashboard"
    xmlns:supportpresentationdashboardviews="clr-namespace:SmartSolucionesCuba.Viderhe.Support.Presentation.Dashboard.Views;assembly=SmartSolucionesCuba.Viderhe.Support.Presentation.Dashboard"
    xmlns:sscxftoolkitmvvmpages="clr-namespace:SmartSolucionesCuba.XFToolKit.Mvvm.Pages;assembly=SmartSolucionesCuba.XFToolKit.Mvvm"
    xmlns:sscxftoolkitpresentationconverters="clr-namespace:SmartSolucionesCuba.XFToolKit.Presentation.Converters;assembly=SmartSolucionesCuba.XFToolKit.Presentation"
    xmlns:ffimageloadingforms="clr-namespace:FFImageLoading.Forms;assembly=FFImageLoading.Forms"
    x:Class="SmartSolucionesCuba.Viderhe.Extend.Essential.Templating.Dashboard.Presentation.Pages.PictureSlideSecuencePlacardConfigurationPage"
    x:TypeArguments="pagemodels:PictureSlideSecuencePlacardConfigurationPageModel"
    x:Name="FormPage">
    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:StringToLocalizeStringConverter x:Key="LocalStringToLocalizeStringConverter" />
            <converters:IsAspectFitWithOpaqueAspectFilledBySelfPictureLayoutModeToBooleanConverter x:Key="IsAspectFitWithOpaqueAspectFilledBySelfPictureLayoutModeToBooleanConverter" />
            <commonconverters:StringToLocalizeStringConverter x:Key="CommonStringToLocalizeStringConverter" />
            <presentationconverters:PictureLayoutModeToXamarinFormAspectConverter x:Key="PictureLayoutModeToXamarinFormAspectConverter" />
            <sscxftoolkitpresentationconverters:FractionConverter x:Key="FractionConverter" />
            <sscxftoolkitpresentationconverters:BoolToBoolNegationConverter x:Key="BoolToBoolNegationConverter" />
            <sscxftoolkitpresentationconverters:BindingLayoutWidthToResponsiveChildWidthConverter x:Key="BindingLayoutWidthToResponsiveChildWidthConverter" ChildMinWidth="320" ChildAbsoluteHorizontalMargin="20" />
        </ResourceDictionary>
    </ContentPage.Resources>
    <ContentPage.ToolbarItems>
        <ToolbarItem 
            Text="Aplicar"
            Clicked="ApplyToolbarItem_Clicked">
            <ToolbarItem.IconImageSource>
                <FontImageSource FontFamily="{StaticResource ToolbarIconFontFamily}" Glyph="&#xf12c;">
                    <FontImageSource.Color>
                        <OnPlatform x:TypeArguments="Color">
                            <On Platform="UWP" Value="Black" />
                        </OnPlatform>
                    </FontImageSource.Color>
                </FontImageSource>
            </ToolbarItem.IconImageSource>
        </ToolbarItem>
        <ToolbarItem 
            Text="Cancelar"
            Clicked="CancelToolbarItem_Clicked">
            <ToolbarItem.IconImageSource>
                <FontImageSource FontFamily="{StaticResource ToolbarIconFontFamily}" Glyph="&#xf156;">
                    <FontImageSource.Color>
                        <OnPlatform x:TypeArguments="Color">
                            <On Platform="UWP" Value="Black" />
                        </OnPlatform>
                    </FontImageSource.Color>
                </FontImageSource>
            </ToolbarItem.IconImageSource>
        </ToolbarItem>
    </ContentPage.ToolbarItems>
    <ContentPage.Content>
        <Grid>
            <supportpresentationdashboardviews:BackgroundView />
            <Grid 
                Margin="10,0,10,10"
                ColumnSpacing="10" RowSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition />
                </Grid.RowDefinitions>
                <StackLayout 
                    Grid.ColumnSpan="3" Grid.Row="0"
                    Padding="0,10,0,0"
                    IsVisible="{Binding Path=IsValid, Converter={StaticResource BoolToBoolNegationConverter}}"
                    BindableLayout.ItemsSource="{Binding Path=ValidationMessages}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate>
                            <Grid 
                                BackgroundColor="Tomato"
                                RowSpacing="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="5" />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition />
                                </Grid.RowDefinitions>
                                <BoxView 
                                    Grid.Column="0" Grid.RowSpan="2"
                                    Color="Red" />
                                <Label
                                    Grid.Column="1" Grid.Row="0"
                                    Padding="5,5,5,2"
                                    Text="{Binding Path=Caption}"
                                    TextColor="White"
                                    FontAttributes="Bold" />
                                <Label 
                                    Grid.Column="1" Grid.Row="1"
                                    Padding="5,0,5,5"
                                    Text="{Binding Path=Message}"
                                    TextColor="White" />
                            </Grid>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </StackLayout>
                <Frame
                    Grid.ColumnSpan="3" Grid.Row="1"
                    Style="{StaticResource FormFieldFrame}">
                    <StackLayout>
                        <Label 
                            x:Name="LabelLabel"
                            Text="Etiqueta" 
                            Style="{StaticResource FormLabel}" />
                        <Entry Text="{Binding Path=Label}">
                            <Entry.Behaviors>
                                <supportpresentationdashboardbehaviors:ViewValidationBehavior
                                    ValidableFormPage="{Reference FormPage}"
                                    FormFieldValidationPresenter="{Static supportpresentationdashboardpresenters:DefaultEntryValidationPresenter.Instance}"
                                    TargetProperty="{Static Entry.TextProperty}"
                                    Label="{Reference LabelLabel}">
                                    <supportpresentationdashboardbehaviors:ViewValidationBehavior.Validators>
                                        <supportpresentationdashboardvalidators:RequiredFormFieldValidator />
                                    </supportpresentationdashboardbehaviors:ViewValidationBehavior.Validators>
                                </supportpresentationdashboardbehaviors:ViewValidationBehavior>
                            </Entry.Behaviors>
                        </Entry>
                    </StackLayout>
                </Frame>
                <Frame 
                    Grid.Column="0" Grid.Row="2"
                    Style="{StaticResource FormFieldFrame}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Label
                            Grid.ColumnSpan="2" Grid.Row="0"
                            Text="Fecha de incio" 
                            Style="{StaticResource FormLabel}" />
                        <Switch 
                            Grid.Column="0" Grid.Row="1"
                            IsToggled="{Binding Path=DefineBeginAt}" />
                        <DatePicker 
                            Grid.Column="1" Grid.Row="1"
                            IsEnabled="{Binding DefineBeginAt, Mode=OneWay}"
                            Date="{Binding Path=BeginAt}" />
                    </Grid>
                </Frame>
                <Frame 
                    Grid.Column="1" Grid.Row="2"
                    Style="{StaticResource FormFieldFrame}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Label
                            Grid.ColumnSpan="2" Grid.Row="0"
                            Text="Fecha de fin" 
                            Style="{StaticResource FormLabel}" />
                        <Switch 
                            Grid.Column="0" Grid.Row="1"
                            IsToggled="{Binding Path=DefineEndAt}" />
                        <DatePicker 
                            Grid.Column="1" Grid.Row="1"
                            IsEnabled="{Binding DefineEndAt, Mode=OneWay}"
                            Date="{Binding Path=EndAt}" />
                    </Grid>
                </Frame>
                <Frame 
                    Grid.Column="2" Grid.Row="2"
                    Style="{StaticResource FormFieldFrame}">
                    <StackLayout>
                        <Label Text="A Pantalla Completa" Style="{StaticResource FormLabel}" />
                        <Switch IsToggled="{Binding Path=RequireUnobstructedPresetation}" />
                    </StackLayout>
                </Frame>
                <Frame 
                    Grid.Column="0" Grid.Row="3"
                    Style="{StaticResource FormFieldFrame}"
                    VerticalOptions="Start">
                    <StackLayout>
                        <Label Text="Orientación de Pantalla" Style="{StaticResource FormLabel}" />
                        <Picker 
                            ItemsSource="{Binding Path=AvailableConfigurationPlayerOrientationSupportKinds}" 
                            SelectedItem="{Binding Path=PlayerOrientationSupportKind}"
                            ItemDisplayBinding="{Binding Converter={StaticResource CommonStringToLocalizeStringConverter}}" />
                    </StackLayout>
                </Frame>
                <Frame
                    Grid.Column="1" Grid.Row="3"
                    Style="{StaticResource FormFieldFrame}">
                    <StackLayout>
                        <Label Text="Tiempo en Pantalla por Imagen" Style="{StaticResource FormLabel}" />
                        <StackLayout Orientation="Horizontal">
                            <Label 
                                Text="{Binding Path=PicturePresentationSecounds}"
                                VerticalTextAlignment="Center" />
                            <Label 
                                Text="Segundos" 
                                HorizontalOptions="StartAndExpand" 
                                VerticalTextAlignment="Center" />
                            <Stepper
                                Minimum="5"
                                Value="{Binding Path=PicturePresentationSecounds}" />
                        </StackLayout>
                    </StackLayout>
                </Frame>
                <Frame
                    Grid.ColumnSpan="3" Grid.Row="4"
                    Style="{StaticResource FormFieldFrame}"
                    Padding="0">
                    <Grid RowSpacing="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition />
                        </Grid.RowDefinitions>
                        <Label 
                            x:Name="ImagesLabel"
                            Grid.Column="0" Grid.Row="0"
                            Style="{StaticResource FormLabel}"
                            Margin="10,10,10,6"
                            Text="Imágenes" />
                        <Button
                            Grid.Column="1" Grid.Row="0"
                            VerticalOptions="Start"
                            Text="Agregar"
                            Clicked="IncludeImagesButton_Clicked" />
                        <ScrollView
                            Grid.ColumnSpan="2" Grid.Row="1"
                            Margin="0"
                            Orientation="Vertical">
                            <ContentView
                                BackgroundColor="DimGray"
                                Padding="0,10,0,0">
                                <FlexLayout
                                    Margin="10,0,10,0"
                                    Wrap="Wrap"
                                    AlignItems="Start" AlignContent="Start"
                                    BindableLayout.ItemsSource="{Binding Path=Slides}">
                                    <FlexLayout.Behaviors>
                                        <supportpresentationdashboardbehaviors:ViewValidationBehavior
                                            ValidableFormPage="{Reference FormPage}"
                                            FormFieldValidationPresenter="{Static supportpresentationdashboardpresenters:DefaultCollectionFlexLayoutValidationPresenter.Instance}"
                                            TargetProperty="{Static BindableLayout.ItemsSourceProperty}"
                                            Label="{Reference ImagesLabel}">
                                            <supportpresentationdashboardbehaviors:ViewValidationBehavior.Validators>
                                                <supportpresentationdashboardvalidators:MinCountFormFieldValidator MinCount="3" />
                                            </supportpresentationdashboardbehaviors:ViewValidationBehavior.Validators>
                                        </supportpresentationdashboardbehaviors:ViewValidationBehavior>
                                    </FlexLayout.Behaviors>
                                    <BindableLayout.EmptyView>
                                        <Label
                                            Margin="10"
                                            Text="No se han agregado elementos"
                                            TextColor="White" />
                                    </BindableLayout.EmptyView>
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate>
                                            <Grid
                                                Margin="10"
                                                BackgroundColor="Black"
                                                WidthRequest="{Binding Source={x:RelativeSource AncestorType={x:Type FlexLayout}}, Path=Width, Converter={StaticResource BindingLayoutWidthToResponsiveChildWidthConverter}}"
                                                RowSpacing="0">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition />
                                                </Grid.RowDefinitions>
                                                <BoxView
                                                    Grid.Row="0"
                                                    Color="SlateGray"
                                                    IsVisible="{Binding Path=LayoutMode, Converter={StaticResource IsAspectFitWithOpaqueAspectFilledBySelfPictureLayoutModeToBooleanConverter}}" />
                                                <ffimageloadingforms:CachedImage 
                                                    Grid.Row="0"
                                                    HeightRequest="{Binding Source={x:RelativeSource Mode=Self}, Path=Width, Converter={StaticResource FractionConverter}, ConverterParameter=1.777777777777778}"
                                                    Source="{Binding Path=Image, Converter={StaticResource ImageViewModelToThumbnailImageSourceConverter}}"
                                                    Aspect="{Binding Path=LayoutMode, Converter={StaticResource PictureLayoutModeToXamarinFormAspectConverter}}"
                                                    CacheType="Disk"
                                                    CacheDuration="8760:00:00" />
                                                <ImageButton
                                                    Grid.Row="0"
                                                    VerticalOptions="Start" HorizontalOptions="End"
                                                    Margin="4"
                                                    WidthRequest="24"
                                                    HeightRequest="24"
                                                    BackgroundColor="#99000000"
                                                    BorderWidth="0"
                                                    CornerRadius="12"
                                                    Clicked="ImageDeleteButton_Clicked">
                                                    <ImageButton.Padding>
                                                        <OnPlatform x:TypeArguments="Thickness">
                                                            <On Platform="UWP" Value="1,0,0,0" />
                                                        </OnPlatform>
                                                    </ImageButton.Padding>
                                                    <ImageButton.Source>
                                                        <FontImageSource 
                                                            Color="White"
                                                            FontFamily="{StaticResource IconFontFamily}"
                                                            Glyph="&#xF156;" />
                                                    </ImageButton.Source>
                                                </ImageButton>
                                                <StackLayout
                                                    Grid.Row="1"
                                                    Padding="8"
                                                    BackgroundColor="White"
                                                    Orientation="Vertical">
                                                    <Label
                                                        VerticalOptions="Center"
                                                        Text="Presentación"
                                                        FontAttributes="Bold"
                                                        FontSize="Caption" />
                                                    <Picker
                                                        HorizontalOptions="FillAndExpand"
                                                        ItemsSource="{Binding Path=AvailableLayoutModes}"
                                                        SelectedItem="{Binding Path=LayoutMode}"
                                                        ItemDisplayBinding="{Binding Converter={StaticResource LocalStringToLocalizeStringConverter}}" />
                                                </StackLayout>
                                            </Grid>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </FlexLayout>
                            </ContentView>
                        </ScrollView>
                    </Grid>
                </Frame>
            </Grid>
            <supportpresentationdashboardviews:BusyView />
        </Grid>
    </ContentPage.Content>
</sscxftoolkitmvvmpages:BindingContextedContentPage>